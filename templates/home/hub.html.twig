<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hub Administrativo</title>
    <link rel="icon" href="https://raw.githubusercontent.com/Projeto-ACBr-Oficial/Docker/main/PHP/img/favico-acbr.png" type="image/x-icon">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/catalog.css' }}">
    <style>
        .admin-shell {
            width: min(1360px, calc(100vw - 32px));
            margin: 24px auto;
            padding: 24px;
            border-radius: 24px;
            background: rgba(255, 250, 241, 0.92);
            box-shadow: var(--shadow);
            backdrop-filter: blur(4px);
        }
        .admin-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 18px;
        }
        .admin-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }
        .admin-grid-top {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 20px;
            margin-top: 20px;
        }
        .admin-grid-compact {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }
        .admin-grid-bottom {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }
        .quick-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }
        .quick-link {
            display: grid;
            gap: 6px;
            padding: 16px;
            border-radius: 16px;
            border: 1px solid var(--line);
            text-decoration: none;
            color: var(--ink);
            background: linear-gradient(180deg, #fffdf8 0%, #f4ebdc 100%);
            box-shadow: var(--shadow-soft);
            transition: transform 0.16s ease, background-color 0.16s ease;
        }
        .quick-link:hover {
            transform: translateY(-1px);
            background: #f7efdf;
        }
        .quick-link strong {
            color: var(--accent);
        }
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
        }
        .summary-card {
            padding: 16px;
            border-radius: 16px;
            border: 1px solid var(--line);
            background: rgba(255,255,255,0.55);
        }
        .summary-card strong {
            display: block;
            margin-bottom: 8px;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 12px;
        }
        .summary-card span {
            font-size: 28px;
            letter-spacing: -0.03em;
        }
        .feed-list {
            display: grid;
            gap: 12px;
        }
        .feed-item {
            display: grid;
            gap: 6px;
            padding: 14px 16px;
            border-radius: 16px;
            border: 1px solid var(--line);
            background: rgba(255,255,255,0.48);
        }
        .feed-item strong {
            color: var(--ink);
        }
        .feed-item p {
            margin: 0;
            color: var(--muted);
            line-height: 1.45;
        }
        .feed-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .module-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }
        .module-card {
            display: grid;
            gap: 6px;
            padding: 14px 16px;
            border-radius: 16px;
            border: 1px solid var(--line);
            background: rgba(255,255,255,0.48);
            text-decoration: none;
            color: var(--ink);
            transition: transform 0.16s ease, background-color 0.16s ease;
        }
        .module-card:hover {
            transform: translateY(-1px);
            background: #f7efdf;
        }
        .module-card strong {
            color: var(--accent);
        }
        .module-stack-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
        }
        .module-stack {
            display: grid;
            gap: 10px;
            padding: 14px 16px;
            border-radius: 16px;
            border: 1px solid var(--line);
            background: rgba(255,255,255,0.48);
        }
        .module-stack strong {
            color: var(--accent);
        }
        .module-stack p {
            margin: 0;
            color: var(--muted);
            line-height: 1.4;
        }
        .module-stack-links {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .module-stack-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 10px;
            border-radius: 999px;
            background: #f7f0e2;
            border: 1px solid rgba(57,43,16,0.08);
            text-decoration: none;
            color: var(--ink);
        }
        .module-stack-links a:hover {
            background: #eedfc3;
        }
        .panel-subgrid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .mini-title {
            margin: 0 0 10px;
            color: var(--accent);
            font-size: 13px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        @media (max-width: 980px) {
            .admin-grid-top,
            .admin-grid,
            .admin-grid-compact,
            .admin-grid-bottom {
                grid-template-columns: 1fr;
            }
            .panel-subgrid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="page-body">
    <div class="admin-shell">
        <nav class="admin-nav">
            <a class="nav-link is-active" href="{{ app.request.basePath ~ '/index.php/' }}">Hub</a>
            <a class="nav-link" href="{{ app.request.basePath ~ '/index.php/catalogo-programas' }}">Catálogo de Programas</a>
            <a class="nav-link" href="{{ app.request.basePath ~ '/index.php/catalogo-testes' }}">Catálogo de Testes</a>
            <a class="nav-link" href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes' }}">Auditoria</a>
            <a class="nav-link" href="{{ app.request.basePath ~ '/index.php/docs' }}">Docs</a>
        </nav>

        <section class="hero">
            <div class="hero-copy">
                <h1>Hub Administrativo</h1>
                <p>Ponto central para operação do ambiente: acesso rápido, resumo da auditoria, falhas recentes e acompanhamento dos testes já capturados.</p>
            </div>
            <div class="hero-stats">
                <article class="stat-card">
                    <strong>Requisições</strong>
                    <span>{{ auditSummary.total }}</span>
                </article>
                <article class="stat-card">
                    <strong>Falhas</strong>
                    <span>{{ auditSummary.falhas }}</span>
                </article>
                <article class="stat-card">
                    <strong>Tempo médio</strong>
                    <span>{{ auditMetrics.tempo_medio_ms }} ms</span>
                </article>
                <article class="stat-card">
                    <strong>Testes</strong>
                    <span>{{ testSummary.total_tests }}</span>
                </article>
            </div>
        </section>

        <section class="admin-grid-top">
            <article class="panel">
                <div class="panel-header">
                    <h2>Operação por módulo</h2>
                    <p>Escolha CEP, NFe ou NFSe e entre direto em docs, testes e auditoria do mesmo fluxo.</p>
                </div>
                <div class="details">
                    <div class="module-stack-grid">
                        {% for stack in moduleStacks %}
                            <div class="module-stack">
                                <strong>{{ stack.label }}</strong>
                                <p>{{ stack.description }}</p>
                                <div class="module-stack-links">
                                    {% for link in stack.links %}
                                        <a href="{{ link.url }}">{{ link.label }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </article>

            <article class="panel">
                <div class="panel-header">
                    <h2>Escolher APIs</h2>
                    <p>Entre direto na documentação da API que você quer testar.</p>
                </div>
                <div class="details">
                    <div class="module-grid">
                        {% for item in apiOptions %}
                            <a class="module-card" href="{{ item.url }}">
                                <strong>{{ item.label }}</strong>
                                <span>{{ item.description }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </article>

        </section>

        <section class="admin-grid-compact">
            <article class="panel">
                <div class="panel-header">
                    <h2>Escolher Docs por módulo</h2>
                    <p>Abra a documentação exatamente no módulo que deseja consultar.</p>
                </div>
                <div class="details">
                    <div class="module-grid">
                        {% for item in apiOptions %}
                            <a class="module-card" href="{{ item.url }}">
                                <strong>{{ item.label|replace({'API Platform: ': ''}) }}</strong>
                                <span>{{ item.description }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </article>

            <article class="panel">
                <div class="panel-header">
                    <h2>Escolher Testes por módulo</h2>
                    <p>Abra o catálogo de testes já filtrado pelo módulo que deseja revisar ou executar.</p>
                </div>
                <div class="details">
                    <div class="module-grid">
                        {% for item in testModuleOptions %}
                            <a class="module-card" href="{{ item.url }}">
                                <strong>{{ item.label }}</strong>
                                <span>{{ item.description }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </article>
        </section>

        <section class="admin-grid">
            <article class="panel">
                <div class="panel-header">
                    <h2>Escolher Demos</h2>
                    <p>Abra direto o demo legado que deseja usar.</p>
                </div>
                <div class="details">
                    <div class="module-grid">
                        {% for item in demoOptions %}
                            <a class="module-card" href="{{ item.url }}">
                                <strong>{{ item.label }}</strong>
                                <span>{{ item.description }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </article>

            <article class="panel">
                <div class="panel-header">
                    <h2>Auditoria e falhas por módulo</h2>
                    <p>Abra o dashboard no recorte certo sem montar URL manualmente.</p>
                </div>
                <div class="details">
                    <div class="panel-subgrid">
                        <div>
                            <h3 class="mini-title">Auditoria</h3>
                            <div class="module-grid">
                                {% for item in auditModuleOptions %}
                                    <a class="module-card" href="{{ item.url }}">
                                        <strong>{{ item.label }}</strong>
                                        <span>{{ item.description }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                        <div>
                            <h3 class="mini-title">Falhas</h3>
                            <div class="module-grid">
                                {% for item in failureModuleOptions %}
                                    <a class="module-card" href="{{ item.url }}">
                                        <strong>{{ item.label }}</strong>
                                        <span>{{ item.description }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </section>

        <section class="admin-grid">
            <article class="panel">
                <div class="panel-header">
                    <h2>Métricas da auditoria</h2>
                    <p>Resumo rápido do que está acontecendo nas APIs.</p>
                </div>
                <div class="details">
                    <div class="summary-grid">
                        <div class="summary-card">
                            <strong>Concluídas</strong>
                            <span>{{ auditSummary.concluidas }}</span>
                        </div>
                        <div class="summary-card">
                            <strong>Enfileiradas</strong>
                            <span>{{ auditSummary.enfileiradas }}</span>
                        </div>
                        <div class="summary-card">
                            <strong>Processando</strong>
                            <span>{{ auditSummary.processando }}</span>
                        </div>
                        <div class="summary-card">
                            <strong>Assinantes</strong>
                            <span>{{ auditSummary.assinantes }}</span>
                        </div>
                        <div class="summary-card">
                            <strong>Async</strong>
                            <span>{{ auditSummary.async }}</span>
                        </div>
                        <div class="summary-card">
                            <strong>Taxa de erro</strong>
                            <span>{{ auditMetrics.taxa_erro_perc }}%</span>
                        </div>
                    </div>
                </div>
            </article>

            <article class="panel">
                <div class="panel-header">
                    <h2>Acesso operacional</h2>
                    <p>Entradas principais para operar o ambiente sem navegar por URL.</p>
                </div>
                <div class="details">
                    <div class="quick-links">
                        <a class="quick-link" href="{{ apisUrl }}">
                            <strong>Explorar APIs</strong>
                            <span>Ver a listagem consolidada das APIs.</span>
                        </a>
                        <a class="quick-link" href="{{ demosUrl }}">
                            <strong>Abrir demos</strong>
                            <span>Ver a listagem consolidada dos demos legados.</span>
                        </a>
                        <a class="quick-link" href="{{ app.request.basePath ~ '/index.php/docs' }}">
                            <strong>Swagger geral</strong>
                            <span>Entrar no catálogo completo do API Platform.</span>
                        </a>
                        <a class="quick-link" href="{{ auditDashboardUrl }}">
                            <strong>Auditoria</strong>
                            <span>Requisições gravadas, fila e respostas.</span>
                        </a>
                        <a class="quick-link" href="{{ testCatalogUrl }}">
                            <strong>Catálogo de testes</strong>
                            <span>Executar e revisar cenários observados.</span>
                        </a>
                        <a class="quick-link" href="{{ catalogUrl }}">
                            <strong>Catálogo de programas</strong>
                            <span>Inventário técnico e histórico dos módulos.</span>
                        </a>
                    </div>
                </div>
            </article>
        </section>

        <section class="admin-grid-bottom">
            <article class="panel">
                <div class="panel-header">
                    <h2>Últimas falhas</h2>
                    <p>Chamadas recentes com falha lógica ou HTTP 4xx/5xx.</p>
                </div>
                <div class="details">
                    <div class="feed-list">
                        {% for item in recentFailures %}
                            <a class="feed-item" href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes?requisicao=' ~ item.u_c_request_id }}">
                                <strong>{{ item.c_metodo }} {{ item.c_caminho }}</strong>
                                <div class="feed-meta">
                                    <span class="chip chip-danger">{{ item.si_status_http ?: 'falha' }}</span>
                                    <span class="chip">{{ item.c_assinante_identificador ?: 'sem assinante' }}</span>
                                    <span class="chip">{{ item.c_cod_programa ?: 'n/d' }}</span>
                                    {% if item.i_tempo_processamento_ms %}
                                        <span class="chip">{{ item.i_tempo_processamento_ms }} ms</span>
                                    {% endif %}
                                </div>
                                <p>{{ item.t_resumo ?: 'Sem resumo adicional.' }}</p>
                            </a>
                        {% else %}
                            <div class="empty">Nenhuma falha recente encontrada.</div>
                        {% endfor %}
                    </div>
                </div>
            </article>

            <article class="panel">
                <div class="panel-header">
                    <h2>Últimos testes</h2>
                    <p>Cenários observados mais recentemente no catálogo.</p>
                </div>
                <div class="details">
                    <div class="feed-list">
                        {% for test in recentTests %}
                            <a class="feed-item" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?teste=' ~ test.code }}">
                                <strong>{{ test.name }}</strong>
                                <div class="feed-meta">
                                    <span class="chip">{{ test.method }}</span>
                                    <span class="chip">{{ test.group_name }}</span>
                                    <span class="chip">{{ test.request_count }} uso(s)</span>
                                    {% if test.last_run %}
                                        <span class="chip{% if test.last_run.success %} chip-success{% else %} chip-danger{% endif %}">
                                            {{ test.last_run.success ? 'ok' : 'erro' }}
                                        </span>
                                    {% endif %}
                                </div>
                                <p>{{ test.path }}</p>
                            </a>
                        {% else %}
                            <div class="empty">Nenhum teste recente encontrado.</div>
                        {% endfor %}
                    </div>
                </div>
            </article>
        </section>
    </div>
</body>
</html>
