<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="app.audit_connection"
                 class="Doctrine\DBAL\Connection">
            <factory class="Doctrine\DBAL\DriverManager" method="getConnection"/>
            <argument type="collection">
                <argument key="driver">pgsql</argument>
                <argument key="host">%env(string:AUDIT_DB_HOST)%</argument>
                <argument key="port">%env(int:AUDIT_DB_PORT)%</argument>
                <argument key="dbname">%env(string:AUDIT_DB_NAME)%</argument>
                <argument key="user">%env(string:AUDIT_DB_USER)%</argument>
                <argument key="password">%env(string:AUDIT_DB_PASSWORD)%</argument>
                <argument key="charset">utf8</argument>
            </argument>
        </service>
    </services>
</container>
