{% extends 'admin/base.html.twig' %}

{% block title %}Saída técnica da NFe {{ detail.numero_nota ?: detail.request_id }}{% endblock %}
{% block page_heading %}Saída técnica da NFe{% endblock %}
{% block heading_text %}Diagnóstico técnico da tentativa de envio, com XML completo, evento de autorização e resposta bruta.{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/kendo/styles/default-main.css' }}">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-output-monitor.css' }}">
{% endblock %}

{% block body %}
    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-start gap-3">
                <div>
                    <div class="small text-muted text-uppercase">Diagnóstico técnico</div>
                    <h2 class="h3 mb-1">Nota {{ detail.numero_nota ?: detail.request_id }}</h2>
                    <p class="text-muted mb-0">{{ detail.cliente ?: 'Destinatário não identificado' }}</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge text-bg-primary">{{ detail.status_envio }}</span>
                    <a class="btn btn-outline-secondary btn-sm" href="{{ backUrl }}">Voltar</a>
                    <a class="btn btn-outline-secondary btn-sm" href="{{ detailUrl }}">Visão do usuário</a>
                    {% if detail.xml_url %}
                        <a class="btn btn-primary btn-sm" href="{{ app.request.basePath ~ '/index.php' ~ detail.xml_url }}">XML completo</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <div id="nfe-output-technical-tabs">
                <ul>
                    <li class="k-active">Resumo técnico</li>
                    <li>XML completo</li>
                    <li>Evento de autorização</li>
                    <li>Resposta bruta</li>
                </ul>
                <div>
                    <dl class="row mb-0 monitor-dl">
                        <dt class="col-sm-3">Request ID</dt><dd class="col-sm-9"><code>{{ detail.request_id }}</code></dd>
                        <dt class="col-sm-3">HTTP</dt><dd class="col-sm-9">{{ detail.status_http ?: '-' }}</dd>
                        <dt class="col-sm-3">Erro</dt><dd class="col-sm-9">{{ detail.erro ?: '-' }}</dd>
                        <dt class="col-sm-3">Assinante</dt><dd class="col-sm-9">{{ detail.assinante_nome ?: detail.assinante_identificador ?: '-' }}</dd>
                        <dt class="col-sm-3">Emitente</dt><dd class="col-sm-9">{{ detail.emitente_nome ?: '-' }}{% if detail.emitente_documento %} ({{ detail.emitente_documento }}){% endif %}</dd>
                        <dt class="col-sm-3">Destinatário</dt><dd class="col-sm-9">{{ detail.cliente ?: '-' }}{% if detail.cliente_documento %} ({{ detail.cliente_documento }}){% endif %}</dd>
                        <dt class="col-sm-3">Cancelamento</dt><dd class="col-sm-9">{% if detail.cancelamento.cancelada %}{{ detail.cancelamento.c_stat }} - {{ detail.cancelamento.motivo ?: 'Cancelada' }}{% if detail.cancelamento.protocolo %} | Protocolo {{ detail.cancelamento.protocolo }}{% endif %}{% else %}-{% endif %}</dd>
                    </dl>
                </div>
                <div>
                    <pre class="monitor-pre">{{ detail.xml_autorizado ?: 'XML completo não disponível.' }}</pre>
                </div>
                <div>
                    <pre class="monitor-pre">{{ detail.xml_evento_autorizacao ?: 'Evento de autorização não disponível.' }}</pre>
                </div>
                <div>
                    <pre class="monitor-pre">{{ detail.resposta_bruta ?: 'Resposta bruta não disponível.' }}</pre>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_scripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/kendo.all.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/cultures/kendo.culture.pt-BR.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/messages/kendo.messages.pt-BR.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/kendo-license.js' }}"></script>
    <script>
        kendo.culture("pt-BR");
    </script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-output-monitor-detail.js' }}"></script>
{% endblock %}
