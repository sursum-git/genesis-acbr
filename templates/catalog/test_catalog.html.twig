{% extends 'catalog/base.html.twig' %}

{% block title %}Catálogo de Testes{% endblock %}
{% block page_title %}Catálogo de Testes{% endblock %}
{% block page_subtitle %}Cenários gravados, reruns e histórico operacional dos testes observados.{% endblock %}
{% block page_heading %}Catálogo de Testes{% endblock %}
{% block heading_text %}Revisão dos cenários exercitados no API Platform, com execução individual, por grupo ou geral a partir do histórico salvo.{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ app.request.basePath ~ '/index.php/' }}">Hub</a></li>
    <li class="breadcrumb-item active" aria-current="page">Catálogo de Testes</li>
{% endblock %}

{% block catalog_body %}
    <section class="hero">
        <div class="hero-copy">
            <h1>Catálogo de Testes</h1>
            <p>Catálogo dos cenários realmente executados no API Platform, com payload, query string, resposta, histórico e rerun individual, por grupo ou geral a partir do que já foi gravado no SQLite.</p>
        </div>
        <div class="hero-stats">
            <article class="stat-card">
                <strong>Cenários</strong>
                <span>{{ summary.total_tests }}</span>
            </article>
            <article class="stat-card">
                <strong>Com payload</strong>
                <span>{{ summary.payload_tests }}</span>
            </article>
            <article class="stat-card">
                <strong>Execuções</strong>
                <span>{{ summary.total_runs }}</span>
            </article>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2>Rerun geral</h2>
            <p>Executa novamente todos os cenários já gravados, usando a base {{ baseUrl }}.</p>
        </div>
        <div class="action-bar">
            <form method="post" action="{{ app.request.basePath ~ '/index.php/catalogo-testes/executar/geral' }}">
                <input type="hidden" name="q" value="{{ search }}">
                <input type="hidden" name="grupo" value="{{ selectedGroupCode }}">
                <input type="hidden" name="teste" value="{{ selectedTest ? selectedTest.code : '' }}">
                <button class="button button-primary" type="submit">Executar tudo</button>
            </form>
        </div>
    </section>

    <section class="group-grid">
        {% for group in groups %}
            <article class="group-card{% if selectedGroup and selectedGroup.code == group.code %} is-active{% endif %}">
                <div>
                    <h3>{{ group.name }}</h3>
                    <p>{{ group.description }}</p>
                </div>
                <div class="chips">
                    <span class="chip">{{ group.module }}</span>
                    <span class="chip">{{ group.payload_tests }} com payload</span>
                    <span class="chip">{{ group.total_tests }} cenários</span>
                </div>
                <div class="group-actions">
                    <a class="button button-secondary" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?grupo=' ~ group.code ~ (search != '' ? '&q=' ~ search|url_encode : '') }}">Ver grupo</a>
                    <form method="post" action="{{ app.request.basePath ~ '/index.php/catalogo-testes/executar/grupo/' ~ group.code }}">
                        <input type="hidden" name="q" value="{{ search }}">
                        <input type="hidden" name="grupo" value="{{ group.code }}">
                        <input type="hidden" name="teste" value="{{ selectedTest ? selectedTest.code : '' }}">
                        <button class="button button-primary" type="submit">Executar grupo</button>
                    </form>
                </div>
            </article>
        {% endfor %}
    </section>

    <section id="test-workspace" class="layout">
        <aside class="panel">
            <div class="panel-header">
                <h2>Cenários gravados</h2>
                <p>Selecione um cenário já capturado no API Platform para inspecionar o payload e refazer a chamada.</p>
            </div>

            <form class="search-form" method="get" action="{{ app.request.basePath ~ '/index.php/catalogo-testes' }}" data-filter-storage="catalogo_testes_filtros" data-clear-storage-selector="[data-clear-test-catalog-filters]">
                <input type="text" name="q" value="{{ search }}" placeholder="Buscar por nfe, cep, nfse, path...">
                <select name="grupo">
                    <option value="">Todos os grupos</option>
                    {% for group in groups %}
                        <option value="{{ group.code }}"{% if selectedGroupCode == group.code %} selected{% endif %}>{{ group.name }}</option>
                    {% endfor %}
                </select>
                <button class="button button-primary" type="submit">Filtrar</button>
                <a class="button button-tertiary" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?csv=1'
                    ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                    ~ (search != '' ? '&q=' ~ search|url_encode : '')
                    ~ '&ordenar=' ~ sort
                    ~ '&direcao=' ~ direction
                }}">Exportar CSV</a>
                <a class="button button-tertiary" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?xlsx=1'
                    ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                    ~ (search != '' ? '&q=' ~ search|url_encode : '')
                    ~ '&ordenar=' ~ sort
                    ~ '&direcao=' ~ direction
                }}">Exportar XLSX</a>
                {% if search != '' or selectedGroupCode != '' %}
                    <a class="button button-secondary" data-clear-test-catalog-filters href="{{ app.request.basePath ~ '/index.php/catalogo-testes' }}">Limpar</a>
                {% endif %}
            </form>

            {% if tests is empty %}
                <div class="empty">Nenhum cenário gravado encontrado para os filtros atuais.</div>
            {% else %}
                <div class="catalog-list catalog-tests">
                    <div class="catalog-list-head">
                        <span><a class="sort-link{% if sort == 'method' %} is-active{% endif %}" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?ordenar=method&direcao=' ~ (sort == 'method' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1' ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '') ~ (search != '' ? '&q=' ~ search|url_encode : '') ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '') }}">Método</a></span>
                        <span><a class="sort-link{% if sort == 'name' %} is-active{% endif %}" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?ordenar=name&direcao=' ~ (sort == 'name' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1' ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '') ~ (search != '' ? '&q=' ~ search|url_encode : '') ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '') }}">Cenário</a></span>
                        <span><a class="sort-link{% if sort == 'group_name' %} is-active{% endif %}" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?ordenar=group_name&direcao=' ~ (sort == 'group_name' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1' ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '') ~ (search != '' ? '&q=' ~ search|url_encode : '') ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '') }}">Grupo</a></span>
                        <span><a class="sort-link{% if sort == 'last_recorded_at' %} is-active{% endif %}" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?ordenar=last_recorded_at&direcao=' ~ (sort == 'last_recorded_at' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1' ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '') ~ (search != '' ? '&q=' ~ search|url_encode : '') ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '') }}">Último</a></span>
                    </div>
                    <div class="catalog-list-body" data-scroll-memory="test_list_scroll" data-keyboard-list data-test-list-body>
                        {% for test in tests %}
                            {% set lastRun = test.last_run %}
                            <a
                                data-keyboard-item
                                data-test-link
                                data-test-code="{{ test.code }}"
                                data-remember-page-scroll="test_page_scroll"
                                class="catalog-row{% if selectedTest and selectedTest.code == test.code %} is-active{% endif %}"
                                href="{{ app.request.basePath ~ '/index.php/catalogo-testes?teste=' ~ test.code
                                    ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                                    ~ (search != '' ? '&q=' ~ search|url_encode : '')
                                    ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '')
                                    ~ '&pagina=' ~ page
                                }}#test-workspace"
                            >
                                <div class="catalog-cell">
                                    <strong>{{ test.method }}</strong>
                                    <span>{{ test.request_count }} uso(s)</span>
                                </div>
                                <div class="catalog-cell">
                                    <strong>{{ test.name }}</strong>
                                    <span>{{ test.description|slice(0, 140) }}{% if test.description|length > 140 %}...{% endif %}</span>
                                </div>
                                <div class="catalog-cell">
                                    <strong>{{ test.group_name }}</strong>
                                    <span class="mono">{{ test.code }}</span>
                                </div>
                                <div class="catalog-cell">
                                    <strong>{{ test.last_recorded_at ? test.last_recorded_at|date('d/m H:i:s') : 'sem data' }}</strong>
                                    {% if lastRun %}
                                        <span>{{ lastRun.success ? 'último ok' : 'último erro' }}</span>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
                <div class="pagination">
                    <div class="pagination-info">Página {{ page }} de {{ totalPages }}. Exibindo {{ tests|length }} de {{ totalTests }} cenários.</div>
                    <div class="nav-actions">
                        {% if page > 1 %}
                            <a class="button button-secondary" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?pagina=' ~ (page - 1)
                                ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                                ~ (search != '' ? '&q=' ~ search|url_encode : '')
                                ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '')
                            }}">Página anterior</a>
                        {% endif %}
                        {% if page < totalPages %}
                            <a class="button button-secondary" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?pagina=' ~ (page + 1)
                                ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                                ~ (search != '' ? '&q=' ~ search|url_encode : '')
                                ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '')
                            }}">Próxima página</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </aside>

        <main class="panel" data-test-detail-panel>
            {% if selectedTest %}
                <div class="panel-header">
                    <h2>{{ selectedTest.name }}</h2>
                    <p>{{ selectedTest.description }}</p>
                </div>

                <div class="details" data-scroll-memory="test_detail_scroll">
                    <div class="detail-tools">
                        <input type="text" class="detail-search-input" placeholder="Buscar dentro deste detalhe..." data-detail-search-input data-detail-search-target="#test-detail-content">
                        <div class="detail-tools-actions">
                            <button class="button button-secondary" type="button" data-fold-open-all>Abrir tudo</button>
                            <button class="button button-tertiary" type="button" data-fold-close-all>Fechar tudo</button>
                            <button class="button button-tertiary" type="button" data-export-detail-html="#test-detail-export" data-export-filename="teste-detalhe.html">Exportar HTML</button>
                            <button class="button button-tertiary" type="button" data-export-detail-print="#test-detail-export">Imprimir detalhe</button>
                        </div>
                    </div>
                    <div class="toolbar">
                        <div class="toolbar-group">
                            <button class="copy-button" type="button" data-copy-text="{{ selectedTest.code }}">Copiar código</button>
                            <button class="copy-button" type="button" data-copy-text="{{ selectedTest.method }} {{ selectedTest.path }}{% if selectedTest.query_string %}?{{ selectedTest.query_string }}{% endif %}">Copiar chamada</button>
                        </div>
                        <div class="toolbar-group">
                            {% if previousTestCode %}
                                <a class="button button-secondary" data-test-link data-test-code="{{ previousTestCode }}" data-remember-page-scroll="test_page_scroll" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?teste=' ~ previousTestCode
                                    ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                                    ~ (search != '' ? '&q=' ~ search|url_encode : '')
                                    ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '')
                                    ~ '&pagina=' ~ page
                                }}#test-workspace">Anterior</a>
                            {% endif %}
                            {% if nextTestCode %}
                                <a class="button button-secondary" data-test-link data-test-code="{{ nextTestCode }}" data-remember-page-scroll="test_page_scroll" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?teste=' ~ nextTestCode
                                    ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                                    ~ (search != '' ? '&q=' ~ search|url_encode : '')
                                    ~ (selectedBatch ? '&lote=' ~ selectedBatch.id : '')
                                    ~ '&pagina=' ~ page
                                }}#test-workspace">Próximo</a>
                            {% endif %}
                        </div>
                    </div>
                    <div class="meta meta-strong">
                        <span>{{ selectedTest.code }}</span>
                        <span>{{ selectedTest.group_name }}</span>
                        <span>{{ selectedTest.method }}</span>
                        <span>{{ selectedTest.request_count }} uso(s)</span>
                    </div>

                    <div class="action-row">
                        <form method="post" action="{{ app.request.basePath ~ '/index.php/catalogo-testes/executar/teste/' ~ selectedTest.code }}">
                            <input type="hidden" name="q" value="{{ search }}">
                            <input type="hidden" name="grupo" value="{{ selectedGroupCode != '' ? selectedGroupCode : selectedTest.group_code }}">
                            <input type="hidden" name="teste" value="{{ selectedTest.code }}">
                            <input type="hidden" name="pagina" value="{{ page }}">
                            <button class="button button-primary" type="submit">Rerun do cenário</button>
                        </form>

                        <form method="post" action="{{ app.request.basePath ~ '/index.php/catalogo-testes/executar/grupo/' ~ selectedTest.group_code }}">
                            <input type="hidden" name="q" value="{{ search }}">
                            <input type="hidden" name="grupo" value="{{ selectedTest.group_code }}">
                            <input type="hidden" name="teste" value="{{ selectedTest.code }}">
                            <input type="hidden" name="pagina" value="{{ page }}">
                            <button class="button button-secondary" type="submit">Rerun do grupo {{ selectedTest.group_name }}</button>
                        </form>
                    </div>

                    <div id="test-detail-content" data-fold-scope data-fold-memory="test_detail_folds">
                    <div id="test-detail-export">
                    <div class="info-grid info-grid-tight">
                        <div class="block block-card" data-detail-search-item>
                            <h4>Endpoint</h4>
                            <pre class="code-block"><code>{{ selectedTest.method }} {{ selectedTest.path }}{% if selectedTest.query_string %}?{{ selectedTest.query_string }}{% endif %}</code></pre>
                        </div>

                        <div class="block block-card" data-detail-search-item>
                            <h4>Base resolvida</h4>
                            <pre class="code-block"><code>{{ baseUrl }}</code></pre>
                        </div>

                        <div class="block block-card" data-detail-search-item>
                            <h4>Captura</h4>
                            <p>Primeira vez em {{ selectedTest.first_recorded_at ?? 'n/a' }} | Última captura em {{ selectedTest.last_recorded_at ?? 'n/a' }}</p>
                            <p>{{ selectedTest.request_count }} uso(s) gravados para este cenário.</p>
                        </div>

                        {% if selectedTest.last_run %}
                            <div class="block block-card" data-detail-search-item>
                                <h4>Última execução</h4>
                                <div class="chips">
                                    <span class="chip{% if selectedTest.last_run.success %} chip-success{% else %} chip-danger{% endif %}">
                                        {{ selectedTest.last_run.success ? 'Sucesso' : 'Falha' }}
                                    </span>
                                    <span class="chip">HTTP {{ selectedTest.last_run.response_status_code ?? 'n/a' }}</span>
                                    <span class="chip">{{ selectedTest.last_run.duration_ms ?? 'n/a' }} ms</span>
                                    <span class="chip">Lote {{ selectedTest.last_run.batch_id }}</span>
                                </div>
                                <p class="muted-text">Executado em {{ selectedTest.last_run.executed_at }}.</p>
                            </div>
                        {% endif %}
                    </div>

                    <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="headers">
                        <summary>Headers</summary>
                        <div class="fold-body">
                            <pre class="code-block"><code>{% for header in selectedTest.headers %}{{ header }}
{% else %}Sem headers adicionais.
{% endfor %}</code></pre>
                        </div>
                    </details>

                    <details class="fold-card" open data-detail-search-item data-fold-item data-fold-key="payload">
                        <summary>Payload</summary>
                        <div class="fold-body">
                            <pre class="code-block"><code>{{ selectedTest.request_body ?? 'Sem body. O teste usa apenas query string.' }}</code></pre>
                        </div>
                    </details>

                    {% if selectedTest.query_string %}
                        <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="query_string">
                            <summary>Query string</summary>
                            <div class="fold-body">
                                <pre class="code-block"><code>{{ selectedTest.query_string }}</code></pre>
                            </div>
                        </details>
                    {% endif %}

                    <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="ultima_resposta">
                        <summary>Última resposta salva</summary>
                        <div class="fold-body">
                            <pre class="code-block"><code>{{ selectedTest.last_response_body ?? 'Nenhuma resposta salva ainda.' }}</code></pre>
                        </div>
                    </details>

                    <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="ultimos_headers">
                        <summary>Últimos headers salvos</summary>
                        <div class="fold-body">
                            <pre class="code-block"><code>{{ selectedTest.last_response_headers ?? 'Nenhum header salvo ainda.' }}</code></pre>
                        </div>
                    </details>

                    <div class="block block-card" data-detail-search-item>
                        <h4>Histórico recente do cenário</h4>
                        {% if selectedTestRuns is empty %}
                            <p>Nenhuma execução registrada ainda.</p>
                        {% else %}
                            <div class="table-wrap">
                                <table class="results-table">
                                    <thead>
                                        <tr>
                                            <th>Quando</th>
                                            <th>Status</th>
                                            <th>HTTP</th>
                                            <th>Tempo</th>
                                            <th>Lote</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for run in selectedTestRuns %}
                                            <tr>
                                                <td>{{ run.executed_at }}</td>
                                                <td>
                                                    <span class="chip{% if run.success %} chip-success{% else %} chip-danger{% endif %}">
                                                        {{ run.success ? 'ok' : 'erro' }}
                                                    </span>
                                                </td>
                                                <td>{{ run.response_status_code ?? 'n/a' }}</td>
                                                <td>{{ run.duration_ms ?? 'n/a' }} ms</td>
                                                <td>{{ run.batch_id }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                    </div>
                    </div>
                </div>
            {% else %}
                <div class="empty">Faça um teste pelo API Platform e ele aparecerá aqui como cenário gravado.</div>
            {% endif %}
        </main>
    </section>

    <section class="layout layout-bottom">
        <section class="panel">
            <div class="panel-header">
                <h2>Lote selecionado</h2>
                <p>{% if selectedBatch %}Resultado consolidado da execução {{ selectedBatch.label }}.{% else %}Nenhum lote executado ainda.{% endif %}</p>
            </div>

            {% if selectedBatch %}
                <div class="details">
                    <div class="meta">
                        <span>{{ selectedBatch.run_mode }}</span>
                        <span>{{ selectedBatch.passed_tests }}/{{ selectedBatch.total_tests }} ok</span>
                        <span>{{ selectedBatch.failed_tests }} falhas</span>
                        <span>{{ selectedBatch.started_at }}</span>
                    </div>

                    <div class="table-wrap block-card">
                        <table class="results-table">
                            <thead>
                                <tr>
                                    <th>Ordem</th>
                                    <th>Teste</th>
                                    <th>Grupo</th>
                                    <th>Status</th>
                                    <th>HTTP</th>
                                    <th>Tempo</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for run in batchRuns %}
                                    <tr>
                                        <td>{{ run.execution_order }}</td>
                                        <td>{{ run.test_name }}</td>
                                        <td>{{ run.group_name }}</td>
                                        <td>
                                            <span class="chip{% if run.success %} chip-success{% else %} chip-danger{% endif %}">
                                                {{ run.success ? 'ok' : 'erro' }}
                                            </span>
                                        </td>
                                        <td>{{ run.response_status_code ?? 'n/a' }}</td>
                                        <td>{{ run.duration_ms ?? 'n/a' }} ms</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if batchRuns is not empty %}
                        {% set firstRun = batchRuns[0] %}
                        <div class="block block-card">
                            <h4>Primeira resposta do lote</h4>
                            <pre class="code-block"><code>{{ firstRun.response_body ?? firstRun.error_message ?? 'Sem retorno registrado.' }}</code></pre>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <div class="empty">As execuções futuras vão aparecer aqui com histórico, status HTTP e tempo de resposta.</div>
            {% endif %}
        </section>

        <aside class="panel">
            <div class="panel-header">
                <h2>Lotes recentes</h2>
                <p>Navegue pelo histórico persistido das últimas execuções.</p>
            </div>

            {% if recentBatches is empty %}
                <div class="empty">Nenhum lote registrado até o momento.</div>
            {% else %}
                <div class="entity-list compact-list">
                    {% for batch in recentBatches %}
                        <a class="entity-item{% if selectedBatch and selectedBatch.id == batch.id %} is-active{% endif %}" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?lote=' ~ batch.id
                            ~ (selectedGroupCode != '' ? '&grupo=' ~ selectedGroupCode : '')
                            ~ (selectedTest ? '&teste=' ~ selectedTest.code : '')
                            ~ (search != '' ? '&q=' ~ search|url_encode : '')
                        }}">
                            <strong>{{ batch.label }}</strong>
                            <p>{{ batch.run_mode|upper }} | {{ batch.started_at }}</p>
                            <div class="chips">
                                <span class="chip chip-success">{{ batch.passed_tests }} ok</span>
                                <span class="chip chip-danger">{{ batch.failed_tests }} falhas</span>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>
    </section>
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const detailConfig = {
                detailScrollKey: 'test_detail_scroll',
                foldStorageKey: 'test_detail_folds',
                initMarkerPrefix: 'test'
            };

            function initTestDetail(scope) {
                window.initCatalogDetailScope(scope, detailConfig);
            }

            initTestDetail(document);
            window.initCatalogPartialNavigation({
                rootMarker: 'testPartialNavigationInit',
                linkSelector: '[data-test-link]',
                detailPanelSelector: '[data-test-detail-panel]',
                listBodySelector: '[data-test-list-body]',
                activeRowSelector: '.catalog-row[data-test-code]',
                activeValueAttribute: 'data-test-code',
                queryParam: 'teste',
                detailScrollKey: detailConfig.detailScrollKey,
                initDetailScope: initTestDetail
            });
        });
    </script>
{% endblock %}
