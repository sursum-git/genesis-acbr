{% extends 'admin/base.html.twig' %}

{% block title %}Usuários{% endblock %}
{% block page_heading %}Usuários{% endblock %}
{% block heading_text %}Cadastro de logins do portal administrativo.{% endblock %}

{% block body %}
{% if loadError %}
    <div class="alert alert-warning">Não foi possível carregar os usuários agora: {{ loadError }}</div>
{% endif %}

<div class="row g-4">
    <div class="col-lg-8">
        <section class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Usuários cadastrados</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle" data-company-bindings-action="{{ app.request.basePath ~ '/index.php/usuarios/empresas/salvar' }}">
                        <thead>
                        <tr>
                            <th>Usuário</th>
                            <th>Nome</th>
                            <th>Tipo</th>
                            <th>Ativo</th>
                            <th>Empresas</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            {% set selectedCompanies = userCompanies[user.id_t00005]|default([]) %}
                            <tr>
                                <td><code>{{ user.c_usuario }}</code></td>
                                <td>{{ user.c_nome ?: '-' }}</td>
                                <td>{{ types[user.c_tipo]|default(user.c_tipo) }}</td>
                                <td>{{ user.log_ativo ? 'sim' : 'não' }}</td>
                                <td style="min-width: 260px;">
                                    {% if selectedCompanies %}
                                        <div class="small text-body-secondary mb-2">
                                            {{ selectedCompanies|map(company => company.c_nome)|join(', ') }}
                                        </div>
                                    {% endif %}
                                    <form method="post" action="{{ app.request.basePath ~ '/index.php/usuarios/empresas/salvar' }}" class="d-grid gap-2">
                                        <input type="hidden" name="usuario_id" value="{{ user.id_t00005 }}">
                                        <div data-company-search data-company-search-url="{{ app.request.basePath ~ '/index.php/usuarios/empresas/busca' }}">
                                            <div class="d-flex flex-wrap gap-1 mb-2" data-company-selected>
                                                {% for company in selectedCompanies %}
                                                    <span class="badge text-bg-secondary d-inline-flex align-items-center gap-2" data-company-chip="{{ company.id_t00006 }}">
                                                        <span>{{ company.c_nome }}</span>
                                                        <input type="hidden" name="empresa_ids[]" value="{{ company.id_t00006 }}">
                                                        <button type="button" class="btn-close btn-close-white" aria-label="Remover empresa" data-company-remove="{{ company.id_t00006 }}" {% if user.c_tipo == 'super_admin' %}disabled{% endif %}></button>
                                                    </span>
                                                {% else %}
                                                    <span class="text-body-secondary small" data-company-empty>Nenhuma empresa vinculada.</span>
                                                {% endfor %}
                                            </div>
                                            <input class="form-control form-control-sm" type="search" placeholder="Buscar empresa por nome ou CNPJ" data-company-input {% if user.c_tipo == 'super_admin' %}disabled{% endif %}>
                                            <div class="list-group mt-1" data-company-results></div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary w-auto" type="submit" {% if user.c_tipo == 'super_admin' %}disabled{% endif %}>Salvar empresas</button>
                                    </form>
                                    {% if user.c_tipo == 'super_admin' %}
                                        <div class="form-text">Admin geral acessa todas as empresas.</div>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5">Nenhum usuário encontrado.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Novo usuário</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ app.request.basePath ~ '/index.php/usuarios/salvar' }}" class="d-grid gap-3">
                    <label class="form-label">
                        Usuário
                        <input class="form-control" type="text" name="usuario" required maxlength="80" autocomplete="off">
                    </label>
                    <label class="form-label">
                        Nome
                        <input class="form-control" type="text" name="nome" maxlength="255" autocomplete="off">
                    </label>
                    <label class="form-label">
                        Senha inicial
                        <input class="form-control" type="password" name="senha" required autocomplete="new-password">
                    </label>
                    <label class="form-label">
                        Tipo
                        <select class="form-select" name="tipo">
                            {% for value, label in types %}
                                <option value="{{ value }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <div class="form-label">
                        Empresas
                        <div data-company-search data-company-search-url="{{ app.request.basePath ~ '/index.php/usuarios/empresas/busca' }}">
                            <div class="d-flex flex-wrap gap-1 mb-2" data-company-selected>
                                <span class="text-body-secondary small" data-company-empty>Nenhuma empresa selecionada.</span>
                            </div>
                            <input class="form-control" type="search" placeholder="Buscar empresa por nome ou CNPJ" data-company-input autocomplete="off">
                            <div class="list-group mt-1" data-company-results></div>
                        </div>
                        <span class="form-text">Digite ao menos 2 caracteres. Admin geral não precisa de vínculo.</span>
                    </div>
                    <div>
                        <button class="btn btn-primary" type="submit">Criar usuário</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
    <script src="{{ app.request.basePath ~ '/catalog-assets/admin/user-company-search.js' }}"></script>
{% endblock %}
