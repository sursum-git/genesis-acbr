{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="card"><div class="card-header"><h3 class="card-title">Bibliotecas ACBr</h3></div><div class="card-body">
<form method="post" action="{{ path('app_acbr_library_releases_save') }}" class="row g-2 mb-4">
<div class="col-md-2"><input class="form-control" name="c_modulo" value="nfe" required></div><div class="col-md-2"><select class="form-select" name="c_ambiente"><option value="homologacao">Homologação</option><option value="producao">Produção</option></select></div><div class="col-md-2"><input class="form-control" name="c_release" placeholder="Release" required></div><div class="col-md-6"><input class="form-control" name="c_caminho_so" placeholder="Caminho completo da .so" required></div><div class="col-md-6"><input class="form-control" name="c_sha256" placeholder="SHA-256" required></div><div class="col-md-2"><input class="form-control" name="c_perfil_ini" placeholder="Perfil INI" required></div><div class="col-md-2"><input class="form-control" type="datetime-local" name="dt_hr_inicio_vigencia" required></div><div class="col-md-2"><input class="form-control" type="datetime-local" name="dt_hr_fim_vigencia"></div><div class="col-md-2"><label><input type="checkbox" name="log_ativo" checked> Ativa</label></div><div class="col-md-2"><button class="btn btn-primary">Cadastrar</button></div><div class="col-12"><textarea class="form-control" name="t_diferencas" rows="4" placeholder="Diferenças desta release (uma por linha)"></textarea></div></form>
<table class="table table-sm"><thead><tr><th>Módulo</th><th>Ambiente</th><th>Release</th><th>Perfil</th><th>Vigência</th><th>Diferenças</th></tr></thead><tbody>{% for item in releases %}<tr><td>{{ item.c_modulo }}</td><td>{{ item.c_ambiente }}</td><td>{{ item.c_release }}</td><td>{{ item.c_perfil_ini }}</td><td>{{ item.dt_hr_inicio_vigencia }} — {{ item.dt_hr_fim_vigencia ?: 'aberta' }}</td><td>{% for change in changesByRelease[item.id_t99037] ?? [] %}<div><strong>{{ change.c_categoria }}</strong>: {{ change.t_descricao }}</div>{% else %}—{% endfor %}</td></tr>{% endfor %}</tbody></table>
</div></div>
{% endblock %}
