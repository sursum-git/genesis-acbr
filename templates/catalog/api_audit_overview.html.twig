{% extends 'catalog/base.html.twig' %}

{% block title %}Visão Analítica da Auditoria{% endblock %}
{% block page_title %}Visão Analítica da Auditoria{% endblock %}
{% block page_subtitle %}Métricas, comparativos e tendências da auditoria de requisições.{% endblock %}
{% block page_heading %}Visão Analítica da Auditoria{% endblock %}
{% block heading_text %}Esta tela concentra o recorte de dashboard da auditoria para deixar a página operacional focada em filtros, consultas e detalhe das requisições.{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ app.request.basePath ~ '/index.php/' }}">Hub</a></li>
    <li class="breadcrumb-item"><a href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes' }}">Auditoria</a></li>
    <li class="breadcrumb-item active" aria-current="page">Visão analítica</li>
{% endblock %}

{% block catalog_body %}
    <section class="hero">
        <div class="hero-copy">
            <h1>Visão Analítica</h1>
            <p>Métricas executivas e séries históricas separadas da consulta operacional para facilitar leitura e acompanhamento do comportamento da API.</p>
        </div>
        <div class="hero-stats">
            <article class="stat-card">
                <strong>Total filtrado</strong>
                <span>{{ summary.total }}</span>
            </article>
            <article class="stat-card">
                <strong>Falhas</strong>
                <span>{{ summary.falhas }}</span>
            </article>
            <article class="stat-card">
                <strong>Tempo médio</strong>
                <span>{{ advancedMetrics.tempo_medio_ms }} ms</span>
            </article>
            <article class="stat-card">
                <strong>Taxa de erro</strong>
                <span>{{ advancedMetrics.taxa_erro_perc }}%</span>
            </article>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2>Fluxo analítico</h2>
            <p>Esta tela ficou dedicada a métricas e gráficos. Para filtros, consultas e detalhe de requisições, use a auditoria operacional no menu lateral.</p>
        </div>
        <div class="portal-actions-inline">
            <a class="button button-secondary" href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes' }}">Ir para auditoria operacional</a>
        </div>
    </section>

    <section class="panel executive-panel">
        <div class="panel-header">
            <h2>Leitura Executiva</h2>
            <p>{{ comparison.label_atual }} contra {{ comparison.label_anterior }}</p>
        </div>
        <div class="details executive-details">
            <div class="executive-deltas">
                <div class="executive-delta-card">
                    <strong>Volume</strong>
                    <span>{{ comparison.atual.total }}</span>
                    <small class="comparison-delta is-{{ comparison.deltas.total.trend }}">{{ comparison.deltas.total.formatted }} | {{ comparison.deltas.total.percent }}%</small>
                </div>
                <div class="executive-delta-card">
                    <strong>Falhas</strong>
                    <span>{{ comparison.atual.falhas }}</span>
                    <small class="comparison-delta is-{{ comparison.deltas.falhas.trend }}">{{ comparison.deltas.falhas.formatted }} | {{ comparison.deltas.falhas.percent }}%</small>
                </div>
                <div class="executive-delta-card">
                    <strong>Tempo médio</strong>
                    <span>{{ comparison.atual.tempo_medio_ms }} ms</span>
                    <small class="comparison-delta is-{{ comparison.deltas.tempo_medio_ms.trend }}">{{ comparison.deltas.tempo_medio_ms.formatted }} | {{ comparison.deltas.tempo_medio_ms.percent }}%</small>
                </div>
                <div class="executive-delta-card">
                    <strong>Taxa de erro</strong>
                    <span>{{ comparison.atual.taxa_erro_perc }}%</span>
                    <small class="comparison-delta is-{{ comparison.deltas.taxa_erro_perc.trend }}">{{ comparison.deltas.taxa_erro_perc.formatted }}</small>
                </div>
            </div>
            <div class="alert-ribbon">
                {% for alert in alerts %}
                    <div class="alert-item is-{{ alert.nivel }}">
                        <strong>{{ alert.titulo }}</strong>
                        <span>{{ alert.mensagem }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="panel analytics-panel">
        <div class="panel-header">
            <h2>Leitura Analítica</h2>
            <p>Séries e rankings para análise de volume, falha, latência e distribuição do tráfego.</p>
        </div>
        <div class="details">
            <div class="group-grid">
                <article class="chart-card">
                    <div>
                        <h3>Requisições por dia</h3>
                        <p>Volume diário das requisições filtradas.</p>
                    </div>
                    {% if advancedMetrics.requisicoes_por_dia_svg.bars is not empty %}
                        <svg class="dashboard-svg-chart" viewBox="0 0 {{ advancedMetrics.requisicoes_por_dia_svg.width }} {{ advancedMetrics.requisicoes_por_dia_svg.height }}" aria-label="Requisições por dia">
                            <line x1="12" y1="{{ advancedMetrics.requisicoes_por_dia_svg.axis_y }}" x2="{{ advancedMetrics.requisicoes_por_dia_svg.width - 12 }}" y2="{{ advancedMetrics.requisicoes_por_dia_svg.axis_y }}" class="chart-axis"></line>
                            {% for item in advancedMetrics.requisicoes_por_dia_svg.bars %}
                                <rect x="{{ item.x }}" y="{{ item.y }}" width="{{ item.width }}" height="{{ item.height }}" rx="1.5" class="chart-bar"></rect>
                                <text x="{{ item.label_x }}" y="{{ item.value_y }}" class="chart-value">{{ item.value }}</text>
                                <text x="{{ item.label_x }}" y="{{ item.label_y }}" class="chart-label">{{ item.label }}</text>
                            {% endfor %}
                        </svg>
                    {% else %}
                        <p>Sem dados.</p>
                    {% endif %}
                </article>

                <article class="chart-card">
                    <div>
                        <h3>Erros por dia</h3>
                        <p>Falhas lógicas ou HTTP 4xx/5xx no período filtrado.</p>
                    </div>
                    {% if advancedMetrics.erros_por_dia_svg.bars is not empty %}
                        <svg class="dashboard-svg-chart is-danger" viewBox="0 0 {{ advancedMetrics.erros_por_dia_svg.width }} {{ advancedMetrics.erros_por_dia_svg.height }}" aria-label="Erros por dia">
                            <line x1="12" y1="{{ advancedMetrics.erros_por_dia_svg.axis_y }}" x2="{{ advancedMetrics.erros_por_dia_svg.width - 12 }}" y2="{{ advancedMetrics.erros_por_dia_svg.axis_y }}" class="chart-axis"></line>
                            {% for item in advancedMetrics.erros_por_dia_svg.bars %}
                                <rect x="{{ item.x }}" y="{{ item.y }}" width="{{ item.width }}" height="{{ item.height }}" rx="1.5" class="chart-bar"></rect>
                                <text x="{{ item.label_x }}" y="{{ item.value_y }}" class="chart-value">{{ item.value }}</text>
                                <text x="{{ item.label_x }}" y="{{ item.label_y }}" class="chart-label">{{ item.label }}</text>
                            {% endfor %}
                        </svg>
                    {% else %}
                        <p>Sem dados.</p>
                    {% endif %}
                </article>

                <article class="chart-card">
                    <div>
                        <h3>Tempo médio por endpoint</h3>
                        <p>Endpoints mais lentos, em média, dentro do filtro atual.</p>
                    </div>
                    {% if advancedMetrics.tempo_medio_por_endpoint is not empty %}
                        <div class="metric-list">
                            {% for endpoint in advancedMetrics.tempo_medio_por_endpoint %}
                                <div class="metric-row metric-row-rich metric-row-endpoint-latency">
                                    <div>
                                        <div class="metric-label metric-label-path mono">{{ endpoint.c_caminho }}</div>
                                        <div class="metric-track">
                                            <div class="metric-fill" style="width: {{ endpoint.bar_percent }}%;"></div>
                                        </div>
                                    </div>
                                    <div class="metric-value metric-badge metric-badge-latency">{{ endpoint.tempo_medio_ms }} ms</div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p>Sem dados.</p>
                    {% endif %}
                </article>
            </div>

            <div class="group-grid analytics-secondary-grid">
                <article class="chart-card">
                    <div>
                        <h3>Top endpoints</h3>
                        <p>Os caminhos com mais ocorrências nos filtros atuais.</p>
                    </div>
                    <div class="metric-list">
                        {% for endpoint in advancedMetrics.top_endpoints %}
                            <div class="metric-row metric-row-rich metric-row-endpoint-latency">
                                <div>
                                    <div class="metric-label metric-label-path mono">{{ endpoint.c_caminho }}</div>
                                    <div class="metric-track">
                                        <div class="metric-fill" style="width: {{ endpoint.bar_percent }}%;"></div>
                                    </div>
                                </div>
                                <div class="metric-value metric-badge metric-badge-latency">{{ endpoint.total }}x</div>
                            </div>
                        {% else %}
                            <p>Sem dados.</p>
                        {% endfor %}
                    </div>
                </article>

                <article class="chart-card">
                    <div>
                        <h3>Top assinantes</h3>
                        <p>Quem mais chamou os endpoints filtrados.</p>
                    </div>
                    <div class="metric-list">
                        {% for assinante in advancedMetrics.top_assinantes %}
                            <div class="metric-row metric-row-rich">
                                <div>
                                    <div class="metric-label">{{ assinante.identificador ?: 'sem identificador' }}{% if assinante.nome %} - {{ assinante.nome }}{% endif %}</div>
                                    <div class="metric-track">
                                        <div class="metric-fill" style="width: {{ assinante.bar_percent }}%;"></div>
                                    </div>
                                </div>
                                <div class="metric-value metric-badge">{{ assinante.total }}x</div>
                            </div>
                        {% else %}
                            <p>Sem dados.</p>
                        {% endfor %}
                    </div>
                </article>

                <article class="chart-card">
                    <div>
                        <h3>Status HTTP</h3>
                        <p>Distribuição dos códigos HTTP retornados.</p>
                    </div>
                    <div class="metric-list">
                        {% for item in advancedMetrics.status_http %}
                            <div class="metric-row metric-row-rich">
                                <div>
                                    <div class="metric-label">HTTP {{ item.status_http }}</div>
                                    <div class="metric-track">
                                        <div class="metric-fill is-danger" style="width: {{ item.bar_percent }}%;"></div>
                                    </div>
                                </div>
                                <div class="metric-value metric-badge">{{ item.total }}</div>
                            </div>
                        {% else %}
                            <p>Sem dados.</p>
                        {% endfor %}
                    </div>
                </article>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
{% endblock %}
