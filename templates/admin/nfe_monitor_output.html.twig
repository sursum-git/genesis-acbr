{% extends 'admin/base.html.twig' %}

{% block title %}Tela de saida NFe{% endblock %}
{% block page_heading %}Tela de saida NFe{% endblock %}
{% block heading_text %}Detalhe operacional e fiscal do envio selecionado no monitor.{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-monitor.css' }}">
{% endblock %}

{% block body %}
    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-start gap-3">
                <div>
                    <div class="small text-muted text-uppercase">Identificacao</div>
                    <h2 class="h3 mb-1">Nota {{ detail.numero_nota ?: 'sem numero estruturado' }}</h2>
                    <p class="text-muted mb-0">{{ detail.cliente ?: 'Cliente nao identificado' }}</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge text-bg-primary">{{ detail.situacao }}</span>
                    <span class="badge text-bg-secondary">{{ detail.ocorrencia }}</span>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <section class="card h-100">
                <div class="card-header">
                    <h3 class="card-title">Resumo da nota</h3>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 monitor-dl">
                        <dt class="col-sm-4">Request ID</dt>
                        <dd class="col-sm-8"><code>{{ detail.request_id }}</code></dd>

                        <dt class="col-sm-4">Numero</dt>
                        <dd class="col-sm-8">{{ detail.numero_nota ?: '-' }}</dd>

                        <dt class="col-sm-4">Cliente</dt>
                        <dd class="col-sm-8">{{ detail.cliente ?: '-' }}</dd>

                        <dt class="col-sm-4">Documento</dt>
                        <dd class="col-sm-8">{{ detail.cliente_documento ?: '-' }}</dd>

                        <dt class="col-sm-4">Valor</dt>
                        <dd class="col-sm-8">{{ detail.valor_total ?: '-' }}</dd>

                        <dt class="col-sm-4">Chave</dt>
                        <dd class="col-sm-8 monitor-break">{{ detail.chave_nfe ?: '-' }}</dd>

                        <dt class="col-sm-4">Recebimento</dt>
                        <dd class="col-sm-8">{{ detail.dt_hr_recebimento ?: '-' }}</dd>

                        <dt class="col-sm-4">Emissao</dt>
                        <dd class="col-sm-8">{{ detail.data_emissao ?: '-' }}</dd>

                        <dt class="col-sm-4">DANFE</dt>
                        <dd class="col-sm-8 monitor-break">{{ detail.caminho_danfe ?: '-' }}</dd>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-6">
            <section class="card h-100">
                <div class="card-header">
                    <h3 class="card-title">Situacao operacional</h3>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 monitor-dl">
                        <dt class="col-sm-4">HTTP</dt>
                        <dd class="col-sm-8">{{ detail.si_status_http ?: '-' }}</dd>

                        <dt class="col-sm-4">Proc.</dt>
                        <dd class="col-sm-8">{{ detail.si_status_processamento ?: '-' }}</dd>

                        <dt class="col-sm-4">Extracao</dt>
                        <dd class="col-sm-8">{{ detail.si_status_extracao ?: '-' }}</dd>

                        <dt class="col-sm-4">Inicio proc.</dt>
                        <dd class="col-sm-8">{{ detail.dt_hr_ini_processamento ?: '-' }}</dd>

                        <dt class="col-sm-4">Fim proc.</dt>
                        <dd class="col-sm-8">{{ detail.dt_hr_fim_processamento ?: '-' }}</dd>

                        <dt class="col-sm-4">Inicio extracao</dt>
                        <dd class="col-sm-8">{{ detail.dt_hr_ini_extracao ?: '-' }}</dd>

                        <dt class="col-sm-4">Fim extracao</dt>
                        <dd class="col-sm-8">{{ detail.dt_hr_fim_extracao ?: '-' }}</dd>

                        <dt class="col-sm-4">Erro execucao</dt>
                        <dd class="col-sm-8">{{ detail.erro_execucao ?: 'nenhum' }}</dd>

                        <dt class="col-sm-4">Erro extracao</dt>
                        <dd class="col-sm-8">{{ detail.erro_extracao ?: 'nenhum' }}</dd>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-6">
            <section class="card">
                <div class="card-header">
                    <h3 class="card-title">Corpo da resposta</h3>
                </div>
                <div class="card-body">
                    <pre class="monitor-pre">{{ detail.t_corpo_resposta ?: 'sem resposta registrada' }}</pre>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-6">
            <section class="card">
                <div class="card-header">
                    <h3 class="card-title">Corpo da requisicao</h3>
                </div>
                <div class="card-body">
                    <pre class="monitor-pre">{{ detail.t_corpo_requisicao ?: 'sem requisicao registrada' }}</pre>
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="card">
                <div class="card-header">
                    <h3 class="card-title">XML autorizado</h3>
                </div>
                <div class="card-body">
                    <pre class="monitor-pre">{{ detail.xml_autorizado ?: 'sem XML autorizado disponivel' }}</pre>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
