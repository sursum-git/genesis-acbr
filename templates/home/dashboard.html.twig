{% extends 'admin/base.html.twig' %}

{% block title %}Hub Administrativo{% endblock %}
{% block header_title %}Dashboard{% endblock %}
{% block header_subtitle %}Visão executiva do ambiente com acesso rápido aos fluxos principais.{% endblock %}

{% block body %}
    <section class="admin-focus-hero">
        <div class="hero">
            <div class="hero-copy">
                <h1>Hub Administrativo</h1>
                <p>O painel principal agora ficou dedicado ao resumo do ambiente. A navegação operacional foi separada por páginas focadas para reduzir ruído e encurtar o caminho até cada função.</p>
            </div>
            <div class="hero-stats">
                <article class="stat-card">
                    <strong>Requisições</strong>
                    <span>{{ auditSummary.total }}</span>
                </article>
                <article class="stat-card">
                    <strong>Falhas</strong>
                    <span>{{ auditSummary.falhas }}</span>
                </article>
                <article class="stat-card">
                    <strong>Tempo médio</strong>
                    <span>{{ auditMetrics.tempo_medio_ms }} ms</span>
                </article>
                <article class="stat-card">
                    <strong>Testes</strong>
                    <span>{{ testSummary.total_tests }}</span>
                </article>
            </div>
        </div>

        <div class="admin-focus-split">
            <div class="admin-summary-grid">
                <article class="admin-summary-card">
                    <strong>Concluídas</strong>
                    <span>{{ auditSummary.concluidas }}</span>
                </article>
                <article class="admin-summary-card">
                    <strong>Enfileiradas</strong>
                    <span>{{ auditSummary.enfileiradas }}</span>
                </article>
                <article class="admin-summary-card">
                    <strong>Assinantes</strong>
                    <span>{{ auditSummary.assinantes }}</span>
                </article>
                <article class="admin-summary-card">
                    <strong>Execuções</strong>
                    <span>{{ testSummary.total_runs }}</span>
                </article>
            </div>

            <aside class="admin-overview-panel">
                <h2>Áreas separadas</h2>
                <p>Cada página ficou dedicada a um uso específico para evitar a mistura de atalhos, docs, demos e monitoramento no mesmo lugar.</p>
                <div class="admin-overview-list">
                    {% for shortcut in shortcuts %}
                        <div class="admin-overview-item">
                            <strong>{{ shortcut.title }}</strong>
                            <span>{{ shortcut.description }}</span>
                            <small>{{ shortcut.meta }}</small>
                        </div>
                    {% endfor %}
                </div>
            </aside>
        </div>
    </section>

    <section class="admin-focus-grid">
        {% for area in focusAreas %}
            <article class="admin-focus-card">
                <div>
                    <h3>{{ area.title }}</h3>
                    <p>{{ area.description }}</p>
                </div>
                <div class="meta">
                    {% for badge in area.badges %}
                        <span>{{ badge }}</span>
                    {% endfor %}
                </div>
                <div class="actions">
                    <a class="button button-primary" href="{{ area.url }}">Abrir página</a>
                </div>
            </article>
        {% endfor %}
    </section>
{% endblock %}
