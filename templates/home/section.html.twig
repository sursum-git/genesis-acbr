{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block page_title %}{{ title }}{% endblock %}
{% block page_subtitle %}{{ subtitle }}{% endblock %}
{% block page_heading %}{{ title }}{% endblock %}
{% block heading_text %}{{ subtitle }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ app.request.basePath ~ '/index.php/' }}">Hub</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
{% endblock %}

{% block body %}
    <section class="portal-panel">
        <div class="portal-kicker">Navegação dedicada</div>
        <h2>{{ title }}</h2>
        <p>{{ subtitle }}</p>
        <div class="portal-card-list">
            {% for item in items %}
                <a class="portal-action-card" href="{{ item.url }}">
                    <strong>{{ item.label }}</strong>
                    <span>{{ item.description|default('Acesso direto para esta área do portal.') }}</span>
                </a>
            {% endfor %}
        </div>
        <div class="portal-actions-inline">
            <a class="button button-primary" href="{{ app.request.basePath ~ '/index.php/' }}">Voltar ao hub</a>
        </div>
    </section>
{% endblock %}
