{% extends 'catalog/base.html.twig' %}

{% set auditPageUrl = app.request.basePath ~ (auditPageUrl|default('/index.php/consulta-requisicoes')) %}
{% set auditPageTitle = auditPageTitle|default('Consulta de Requisições') %}
{% set auditPageSubtitle = auditPageSubtitle|default('Pesquisa completa das chamadas gravadas, com foco em request, response e rastreabilidade por request_id.') %}
{% set auditPageHeading = auditPageHeading|default('Consulta de Requisições') %}
{% set auditPageHeadingText = auditPageHeadingText|default('Página dedicada para localizar requisições e inspecionar request, response, erros, tentativas e eventos operacionais completos.') %}
{% set auditBreadcrumbLabel = auditBreadcrumbLabel|default('Consulta de requisições') %}
{% set auditStoragePrefix = auditStoragePrefix|default('consulta_requisicoes') %}
{% set auditExportFilenamePrefix = auditExportFilenamePrefix|default('consulta_requisicoes') %}
{% set filterQuery = (filters.q != '' ? '&q=' ~ filters.q|url_encode : '')
    ~ (filters.assinante != '' ? '&assinante=' ~ filters.assinante|url_encode : '')
    ~ (filters.metodo != '' ? '&metodo=' ~ filters.metodo|url_encode : '')
    ~ (filters.modo != '' ? '&modo=' ~ filters.modo|url_encode : '')
    ~ (filters.programa != '' ? '&programa=' ~ filters.programa|url_encode : '')
    ~ (filters.status_processamento != '' ? '&status_processamento=' ~ filters.status_processamento|url_encode : '')
    ~ (filters.status_http != '' ? '&status_http=' ~ filters.status_http|url_encode : '')
    ~ (filters.caminho != '' ? '&caminho=' ~ filters.caminho|url_encode : '')
    ~ (filters.data_ini != '' ? '&data_ini=' ~ filters.data_ini|url_encode : '')
    ~ (filters.data_fim != '' ? '&data_fim=' ~ filters.data_fim|url_encode : '') %}
{% set sortQuery = '&ordenar=' ~ sort ~ '&direcao=' ~ direction %}
{% set pageQuery = '&pagina=' ~ page %}
{% set detailBaseUrl = auditPageUrl ~ '?limite=' ~ limit ~ sortQuery ~ filterQuery %}
{% set detailFileName = auditExportFilenamePrefix ~ '-detalhe.html' %}

{% block title %}{{ auditPageTitle }}{% endblock %}
{% block page_title %}{{ auditPageTitle }}{% endblock %}
{% block page_subtitle %}{{ auditPageSubtitle }}{% endblock %}
{% block page_heading %}{{ auditPageHeading }}{% endblock %}
{% block heading_text %}{{ auditPageHeadingText }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ app.request.basePath ~ '/index.php/' }}">Hub</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ auditBreadcrumbLabel }}</li>
{% endblock %}

{% block catalog_body %}
    <section class="panel">
        <div class="panel-header">
            <h2>Filtros</h2>
            <p>Use combinações simples para localizar chamadas específicas ou analisar um período.</p>
        </div>

        <form class="search-form" method="get" action="{{ auditPageUrl }}" data-filter-storage="{{ auditStoragePrefix }}_filtros" data-clear-storage-selector="[data-clear-audit-filters]">
            <input type="text" name="q" value="{{ filters.q }}" placeholder="Buscar por request_id, endpoint, operação, assinante...">
            <select name="assinante">
                <option value="">Todos os assinantes</option>
                {% for assinante in assinantes %}
                    <option value="{{ assinante.identificador }}"{% if filters.assinante == assinante.identificador %} selected{% endif %}>{{ assinante.identificador }}{% if assinante.nome %} - {{ assinante.nome }}{% endif %}</option>
                {% endfor %}
            </select>
            <select name="metodo">
                <option value="">Todos os métodos</option>
                {% for method in methods %}
                    <option value="{{ method }}"{% if filters.metodo == method %} selected{% endif %}>{{ method }}</option>
                {% endfor %}
            </select>
            <select name="modo">
                <option value="">Todos os modos</option>
                {% for mode in modes %}
                    <option value="{{ mode }}"{% if filters.modo == mode %} selected{% endif %}>{{ mode }}</option>
                {% endfor %}
            </select>
            <select name="programa">
                <option value="">Todos os programas</option>
                {% for program in programs %}
                    <option value="{{ program }}"{% if filters.programa == program %} selected{% endif %}>{{ program }}</option>
                {% endfor %}
            </select>
            <select name="status_processamento">
                <option value="">Todos os status</option>
                {% for code, label in statusOptions %}
                    <option value="{{ code }}"{% if filters.status_processamento == (code ~ '') %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <input type="text" name="status_http" value="{{ filters.status_http }}" placeholder="HTTP ex.: 200">
            <input type="text" name="caminho" value="{{ filters.caminho }}" placeholder="Caminho ex.: /nfe/consultas">
            <input type="date" name="data_ini" value="{{ filters.data_ini }}">
            <input type="date" name="data_fim" value="{{ filters.data_fim }}">
            <select name="limite">
                {% for option in [40, 80, 120, 200, 300] %}
                    <option value="{{ option }}"{% if limit == option %} selected{% endif %}>{{ option }} linhas</option>
                {% endfor %}
            </select>
            <button class="button button-primary" type="submit">Filtrar</button>
            <a class="button button-tertiary" href="{{ auditPageUrl ~ '?csv=1&limite=' ~ limit ~ sortQuery ~ filterQuery }}">Exportar CSV</a>
            <a class="button button-tertiary" href="{{ auditPageUrl ~ '?xlsx=1&limite=' ~ limit ~ sortQuery ~ filterQuery }}">Exportar XLSX</a>
            <a class="button button-secondary" data-clear-audit-filters href="{{ auditPageUrl }}">Limpar</a>
        </form>

        <div class="preset-bar">
            {% for preset in presets %}
                <a class="button button-secondary" href="{{ auditPageUrl ~ '?pagina=1&limite=' ~ limit ~ sortQuery
                    ~ (preset.query.q is defined ? '&q=' ~ preset.query.q|url_encode : '')
                    ~ (preset.query.assinante is defined ? '&assinante=' ~ preset.query.assinante|url_encode : '')
                    ~ (preset.query.metodo is defined ? '&metodo=' ~ preset.query.metodo|url_encode : '')
                    ~ (preset.query.modo is defined ? '&modo=' ~ preset.query.modo|url_encode : '')
                    ~ (preset.query.programa is defined ? '&programa=' ~ preset.query.programa|url_encode : '')
                    ~ (preset.query.status_processamento is defined ? '&status_processamento=' ~ preset.query.status_processamento|url_encode : '')
                }}">{{ preset.label }}</a>
            {% endfor %}
        </div>

        <div class="saved-filter-panel" data-saved-filter-root data-storage-key="{{ auditStoragePrefix }}_favoritos">
            <div class="saved-filter-form">
                <input type="text" placeholder="Nome do filtro salvo" data-saved-filter-name>
                <button class="button button-primary" type="button" data-save-current-filter>Salvar filtro atual</button>
                <button class="button button-tertiary" type="button" data-copy-current-filter-link>Copiar link atual</button>
            </div>
            <div class="saved-filter-list" data-saved-filter-list>
                <span class="muted-text">Nenhum filtro salvo ainda.</span>
            </div>
        </div>
    </section>

    <section id="audit-workspace" class="panel audit-workspace">
        <div class="panel-header">
            <h2>Requisições</h2>
            <p>Listagem completa para consulta operacional. Use o botão da grade para abrir o detalhe lateral.</p>
        </div>

        {% if requests is empty %}
            <div class="empty">Nenhuma requisição encontrada para os filtros atuais.</div>
        {% else %}
            <div class="audit-grid-wrap">
                <table class="results-table audit-grid-table">
                    <thead>
                        <tr>
                            <th><a class="sort-link{% if sort == 'dt_hr_recebimento' %} is-active{% endif %}" href="{{ auditPageUrl ~ '?ordenar=dt_hr_recebimento&direcao=' ~ (sort == 'dt_hr_recebimento' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1&limite=' ~ limit ~ filterQuery }}">Recebida em</a></th>
                            <th><a class="sort-link{% if sort == 'assinante' %} is-active{% endif %}" href="{{ auditPageUrl ~ '?ordenar=assinante&direcao=' ~ (sort == 'assinante' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1&limite=' ~ limit ~ filterQuery }}">Assinante</a></th>
                            <th><a class="sort-link{% if sort == 'caminho' %} is-active{% endif %}" href="{{ auditPageUrl ~ '?ordenar=caminho&direcao=' ~ (sort == 'caminho' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1&limite=' ~ limit ~ filterQuery }}">Requisição</a></th>
                            <th><a class="sort-link{% if sort == 'status' %} is-active{% endif %}" href="{{ auditPageUrl ~ '?ordenar=status&direcao=' ~ (sort == 'status' and direction == 'asc' ? 'desc' : 'asc') ~ '&pagina=1&limite=' ~ limit ~ filterQuery }}">Status</a></th>
                            <th class="audit-grid-actions-head">Ações</th>
                        </tr>
                    </thead>
                    <tbody data-audit-grid-body>
                        {% for item in requests %}
                            <tr class="audit-grid-row{% if selectedRequest and selectedRequest.u_c_request_id == item.u_c_request_id %} is-active{% endif %}" data-request-id="{{ item.u_c_request_id }}">
                                <td>
                                    <div class="audit-cell-stack">
                                        <strong>{{ item.dt_hr_recebimento|date('d/m/Y H:i:s') }}</strong>
                                        <span>{{ item.c_metodo }}</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="audit-cell-stack">
                                        <strong>{{ item.c_assinante_identificador ?: 'sem assinante' }}</strong>
                                        <span>{{ item.c_assinante_nome ?: 'sem nome' }}</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="audit-cell-stack">
                                        <strong>{{ item.c_caminho }}</strong>
                                        <span class="mono">{{ item.u_c_request_id }}</span>
                                        <span>
                                            {% if item.c_modo_execucao %}{{ item.c_modo_execucao }}{% else %}sync/async n/d{% endif %}
                                            {% if item.si_status_http %} | HTTP {{ item.si_status_http }}{% endif %}
                                            {% if item.c_cod_programa %} | {{ item.c_cod_programa }}{% endif %}
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="audit-cell-stack">
                                        <strong>
                                            <span class="chip{% if item.si_status_processamento == 3 %} chip-success{% elseif item.si_status_processamento in [4, 5] %} chip-danger{% endif %}">{{ statusOptions[item.si_status_processamento] ?? item.si_status_processamento }}</span>
                                        </strong>
                                        <span>
                                            Extração:
                                            <span class="chip{% if item.si_status_extracao == 3 %} chip-success{% elseif item.si_status_extracao == 4 %} chip-danger{% elseif item.si_status_extracao == 2 %} chip-warning{% endif %}">{{ extractionStatusOptions[item.si_status_extracao] ?? item.si_status_extracao }}</span>
                                        </span>
                                        {% if item.t_resumo %}
                                            <span>{{ item.t_resumo|slice(0, 180) }}{% if item.t_resumo|length > 180 %}...{% endif %}</span>
                                        {% else %}
                                            <span>Sem resumo salvo.</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="audit-grid-actions">
                                    <a
                                        class="button button-secondary"
                                        data-audit-request-link
                                        data-request-id="{{ item.u_c_request_id }}"
                                        href="{{ detailBaseUrl ~ pageQuery ~ '&requisicao=' ~ item.u_c_request_id }}#audit-workspace"
                                    >Ver detalhes</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="pagination">
                <div class="pagination-info">Página {{ page }} de {{ totalPages }}. Exibindo {{ requests|length }} de {{ totalRequests }} requisições.</div>
                <div class="nav-actions">
                    {% if page > 1 %}
                        <a class="button button-secondary" href="{{ auditPageUrl ~ '?pagina=' ~ (page - 1) ~ '&limite=' ~ limit ~ sortQuery ~ filterQuery }}">Página anterior</a>
                    {% endif %}
                    {% if page < totalPages %}
                        <a class="button button-secondary" href="{{ auditPageUrl ~ '?pagina=' ~ (page + 1) ~ '&limite=' ~ limit ~ sortQuery ~ filterQuery }}">Próxima página</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>

    <aside class="audit-detail-drawer{% if selectedRequest %} is-open{% endif %}" data-audit-detail-drawer data-selected-request-id="{{ selectedRequest ? selectedRequest.u_c_request_id : '' }}">
        <button class="audit-detail-backdrop" type="button" aria-label="Fechar detalhe" data-close-audit-drawer></button>
        <div class="audit-detail-shell">
            <section class="panel audit-detail-frame">
                {% if selectedRequest %}
                    <div class="panel-header audit-detail-header-row">
                        <div>
                            <h2>Detalhes da Requisição</h2>
                            <p>Request, response, erro, tentativas e eventos operacionais completos.</p>
                        </div>
                        <button class="button button-tertiary" type="button" data-close-audit-drawer>Fechar</button>
                    </div>

                    <div class="details audit-detail-panel" data-scroll-memory="{{ auditStoragePrefix }}_detail_scroll">
                        <div class="detail-tools">
                            <input type="text" class="detail-search-input" placeholder="Buscar dentro deste detalhe..." data-detail-search-input data-detail-search-target="#audit-detail-content">
                            <div class="detail-tools-actions">
                                <button class="button button-secondary" type="button" data-fold-open-all>Abrir tudo</button>
                                <button class="button button-tertiary" type="button" data-fold-close-all>Fechar tudo</button>
                                <button class="button button-tertiary" type="button" data-export-detail-html="#audit-detail-export" data-export-filename="{{ detailFileName }}">Exportar HTML</button>
                                <button class="button button-tertiary" type="button" data-export-detail-print="#audit-detail-export">Imprimir detalhe</button>
                            </div>
                        </div>

                        <div class="toolbar">
                            <div class="toolbar-group">
                                <button class="copy-button" type="button" data-copy-text="{{ selectedRequest.u_c_request_id }}">Copiar request_id</button>
                                <button class="copy-button" type="button" data-copy-text="{{ selectedRequest.c_metodo }} {{ selectedRequest.c_caminho }}">Copiar chamada</button>
                            </div>
                            <div class="toolbar-group">
                                {% if previousRequestId %}
                                    <a class="button button-secondary" data-audit-request-link data-request-id="{{ previousRequestId }}" href="{{ detailBaseUrl ~ pageQuery ~ '&requisicao=' ~ previousRequestId }}#audit-workspace">Anterior</a>
                                {% endif %}
                                {% if nextRequestId %}
                                    <a class="button button-secondary" data-audit-request-link data-request-id="{{ nextRequestId }}" href="{{ detailBaseUrl ~ pageQuery ~ '&requisicao=' ~ nextRequestId }}#audit-workspace">Próxima</a>
                                {% endif %}
                            </div>
                        </div>

                        <div class="audit-detail-hero">
                            <div class="audit-detail-title-wrap">
                                <div class="audit-detail-kicker">Requisição selecionada</div>
                                <h3>{{ selectedRequest.c_metodo }} {{ selectedRequest.c_caminho }}</h3>
                            </div>
                            <div class="meta meta-strong audit-detail-meta">
                                <span>{{ selectedRequest.u_c_request_id }}</span>
                                <span class="{% if selectedRequest.si_status_processamento in [4, 5] %}chip-danger{% elseif selectedRequest.si_status_processamento == 3 %}chip-success{% else %}chip-warning{% endif %}">{{ statusOptions[selectedRequest.si_status_processamento] ?? selectedRequest.si_status_processamento }}</span>
                                {% if selectedRequest.si_status_http %}
                                    <span class="{% if selectedRequest.si_status_http >= 400 %}chip-danger{% else %}chip-success{% endif %}">HTTP {{ selectedRequest.si_status_http }}</span>
                                {% endif %}
                                {% if selectedRequest.c_modo_execucao %}
                                    <span>{{ selectedRequest.c_modo_execucao }}</span>
                                {% endif %}
                                {% if selectedRequest.si_status_extracao is defined %}
                                    <span class="{% if selectedRequest.si_status_extracao == 4 %}chip-danger{% elseif selectedRequest.si_status_extracao == 3 %}chip-success{% else %}chip-warning{% endif %}">Extração {{ extractionStatusOptions[selectedRequest.si_status_extracao] ?? selectedRequest.si_status_extracao }}</span>
                                {% endif %}
                                {% if selectedRequest.i_tempo_processamento_ms %}
                                    <span class="{% if selectedRequest.i_tempo_processamento_ms >= 3000 %}chip-danger{% elseif selectedRequest.i_tempo_processamento_ms >= 1200 %}chip-warning{% endif %}">{{ selectedRequest.i_tempo_processamento_ms }} ms</span>
                                {% endif %}
                            </div>
                        </div>

                        <div id="audit-detail-content" data-fold-scope data-fold-memory="{{ auditStoragePrefix }}_detail_folds">
                            <div id="audit-detail-export">
                                <div class="audit-detail-summary">
                                    <section class="audit-summary-group" data-detail-search-item>
                                        <dl class="audit-summary-list">
                                            <div class="audit-summary-row">
                                                <dt>Assinante</dt>
                                                <dd>{{ selectedRequest.c_assinante_identificador ?: 'não identificado' }}{% if selectedRequest.c_assinante_nome %} - {{ selectedRequest.c_assinante_nome }}{% endif %}</dd>
                                            </div>
                                            <div class="audit-summary-row">
                                                <dt>Programa</dt>
                                                <dd>{{ selectedRequest.c_cod_programa ?: 'n/d' }}{% if selectedRequest.c_nome_programa %} - {{ selectedRequest.c_nome_programa }}{% endif %}</dd>
                                            </div>
                                            <div class="audit-summary-row">
                                                <dt>Versão</dt>
                                                <dd>{{ selectedRequest.c_versao_programa ?: 'n/d' }} | Revisão {{ selectedRequest.c_revisao_programa ?: 'n/d' }}</dd>
                                            </div>
                                            <div class="audit-summary-row">
                                                <dt>Fonte da versão</dt>
                                                <dd>{{ selectedRequest.c_fonte_versao ?: 'n/d' }}</dd>
                                            </div>
                                        </dl>
                                    </section>

                                    <section class="audit-summary-group" data-detail-search-item>
                                        <dl class="audit-summary-list">
                                            <div class="audit-summary-row">
                                                <dt>Recebida em</dt>
                                                <dd>{{ selectedRequest.dt_hr_recebimento ?: 'n/d' }}</dd>
                                            </div>
                                            <div class="audit-summary-row">
                                                <dt>Processamento</dt>
                                                <dd>Início {{ selectedRequest.dt_hr_ini_processamento ?: 'n/d' }} | Fim {{ selectedRequest.dt_hr_fim_processamento ?: 'n/d' }}</dd>
                                            </div>
                                            <div class="audit-summary-row">
                                                <dt>Extração</dt>
                                                <dd>
                                                    {{ extractionStatusOptions[selectedRequest.si_status_extracao] ?? selectedRequest.si_status_extracao ?? 'n/d' }}
                                                    | Início {{ selectedRequest.dt_hr_ini_extracao ?: 'n/d' }}
                                                    | Fim {{ selectedRequest.dt_hr_fim_extracao ?: 'n/d' }}
                                                </dd>
                                            </div>
                                            <div class="audit-summary-row">
                                                <dt>Origem</dt>
                                                <dd>{{ selectedRequest.c_ip_origem ?: 'n/d' }}</dd>
                                            </div>
                                            {% if selectedRequest.c_nome_operacao or selectedRequest.c_rota %}
                                                <div class="audit-summary-row">
                                                    <dt>Roteamento</dt>
                                                    <dd>Operação {{ selectedRequest.c_nome_operacao ?: 'n/d' }} | Rota {{ selectedRequest.c_rota ?: 'n/d' }}</dd>
                                                </div>
                                            {% endif %}
                                        </dl>
                                    </section>
                                </div>

                                {% if selectedRequest.t_query_string %}
                                    <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="query_string">
                                        <summary>Query string</summary>
                                        <div class="fold-body">
                                            <pre class="code-block"><code>{{ selectedRequest.t_query_string }}</code></pre>
                                        </div>
                                    </details>
                                {% endif %}

                                <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="headers_requisicao">
                                    <summary>Headers da requisição</summary>
                                    <div class="fold-body">
                                        <pre class="code-block"><code>{{ selectedRequest.t_headers_requisicao_pretty ?? selectedRequest.t_headers_requisicao ?? 'Sem headers salvos.' }}</code></pre>
                                    </div>
                                </details>

                                <details class="fold-card" open data-detail-search-item data-fold-item data-fold-key="corpo_requisicao">
                                    <summary>Corpo da requisição</summary>
                                    <div class="fold-body">
                                        <pre class="code-block"><code>{{ selectedRequest.t_corpo_requisicao ?? 'Sem body.' }}</code></pre>
                                    </div>
                                </details>

                                <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="headers_resposta">
                                    <summary>Headers da resposta</summary>
                                    <div class="fold-body">
                                        <pre class="code-block"><code>{{ selectedRequest.t_headers_resposta_pretty ?? selectedRequest.t_headers_resposta ?? 'Sem headers salvos.' }}</code></pre>
                                    </div>
                                </details>

                                <details class="fold-card" open data-detail-search-item data-fold-item data-fold-key="corpo_resposta">
                                    <summary>Corpo da resposta</summary>
                                    <div class="fold-body">
                                        <pre class="code-block"><code>{{ selectedRequest.t_corpo_resposta ?? 'Sem resposta salva.' }}</code></pre>
                                    </div>
                                </details>

                                {% if selectedRequest.t_erro %}
                                    <details class="fold-card is-danger" open data-detail-search-item data-fold-item data-fold-key="erro">
                                        <summary>Erro</summary>
                                        <div class="fold-body">
                                            <pre class="code-block"><code>{{ selectedRequest.t_erro }}</code></pre>
                                        </div>
                                    </details>
                                {% endif %}

                                {% if selectedRequest.t_erro_extracao %}
                                    <details class="fold-card is-danger" open data-detail-search-item data-fold-item data-fold-key="erro_extracao">
                                        <summary>Erro de extração</summary>
                                        <div class="fold-body">
                                            <pre class="code-block"><code>{{ selectedRequest.t_erro_extracao }}</code></pre>
                                        </div>
                                    </details>
                                {% endif %}

                                <details class="fold-card" data-detail-search-item data-fold-item data-fold-key="snapshot_assinante">
                                    <summary>Snapshot do assinante</summary>
                                    <div class="fold-body">
                                        <pre class="code-block"><code>{{ selectedRequest.t_assinante_json_pretty ?? selectedRequest.t_assinante_json ?? 'Sem snapshot salvo.' }}</code></pre>
                                    </div>
                                </details>

                                <details class="fold-card" open data-detail-search-item data-fold-item data-fold-key="nfe_extraidas">
                                    <summary>NFe extraídas ({{ extractedNfe|length }})</summary>
                                    <div class="fold-body">
                                        {% if extractedNfe is empty %}
                                            <p>Nenhuma NFe extraída para esta requisição.</p>
                                        {% else %}
                                            <pre class="code-block"><code>{{ extractedNfe|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
                                        {% endif %}
                                    </div>
                                </details>

                                <details class="fold-card" open data-detail-search-item data-fold-item data-fold-key="nsu_extraidos">
                                    <summary>Itens NSU extraídos ({{ extractedNsu|length }})</summary>
                                    <div class="fold-body">
                                        {% if extractedNsu is empty %}
                                            <p>Nenhum item NSU extraído para esta requisição.</p>
                                        {% else %}
                                            <pre class="code-block"><code>{{ extractedNsu|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
                                        {% endif %}
                                    </div>
                                </details>

                                <div class="block block-card" data-detail-search-item>
                                    <h4>Tentativas do worker</h4>
                                    {% if attempts is empty %}
                                        <p>Sem tentativas registradas na `t99002`.</p>
                                    {% else %}
                                        <div class="table-wrap">
                                            <table class="results-table">
                                                <thead>
                                                    <tr>
                                                        <th>Tentativa</th>
                                                        <th>Worker</th>
                                                        <th>PID</th>
                                                        <th>Status</th>
                                                        <th>HTTP</th>
                                                        <th>Versão</th>
                                                        <th>Início</th>
                                                        <th>Fim</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for attempt in attempts %}
                                                        <tr>
                                                            <td>{{ attempt.si_num_tentativa }}</td>
                                                            <td>{{ attempt.c_worker_id ?: 'n/d' }}</td>
                                                            <td>{{ attempt.i_worker_pid ?: 'n/d' }}</td>
                                                            <td>{{ statusOptions[attempt.si_status_processamento] ?? attempt.si_status_processamento }}</td>
                                                            <td>{{ attempt.si_status_http ?: 'n/d' }}</td>
                                                            <td>{{ attempt.c_versao_programa ?: 'n/d' }}</td>
                                                            <td>{{ attempt.dt_hr_ini_processamento ?: 'n/d' }}</td>
                                                            <td>{{ attempt.dt_hr_fim_processamento ?: 'n/d' }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="block block-card" data-detail-search-item>
                                    <h4>Eventos operacionais</h4>
                                    {% if events is empty %}
                                        <p>Sem eventos registrados na `t99004`.</p>
                                    {% else %}
                                        <div class="table-wrap">
                                            <table class="results-table">
                                                <thead>
                                                    <tr>
                                                        <th>Quando</th>
                                                        <th>Evento</th>
                                                        <th>Detalhe</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for event in events %}
                                                        <tr>
                                                            <td>{{ event.dt_hr_evento }}</td>
                                                            <td>{{ event.c_evento }}</td>
                                                            <td>{{ event.t_detalhe ?: 'n/d' }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="panel-header audit-detail-header-row">
                        <div>
                            <h2>Detalhes da Requisição</h2>
                            <p>Selecione uma linha da grade para abrir o detalhe lateral.</p>
                        </div>
                        <button class="button button-tertiary" type="button" data-close-audit-drawer>Fechar</button>
                    </div>
                    <div class="empty">Nenhuma requisição selecionada.</div>
                {% endif %}
            </section>
        </div>
    </aside>
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const detailConfig = {
                detailScrollKey: '{{ auditStoragePrefix }}_detail_scroll',
                foldStorageKey: '{{ auditStoragePrefix }}_detail_folds',
                initMarkerPrefix: '{{ auditStoragePrefix }}'
            };

            function initAuditDetail(scope) {
                window.initCatalogDetailScope(scope, detailConfig);
            }

            function updateActiveRow(requestId) {
                document.querySelectorAll('.audit-grid-row[data-request-id]').forEach(function (row) {
                    row.classList.toggle('is-active', (row.getAttribute('data-request-id') || '') === requestId);
                });
            }

            function replaceDrawerFromDocument(doc) {
                const currentDrawer = document.querySelector('[data-audit-detail-drawer]');
                const nextDrawer = doc.querySelector('[data-audit-detail-drawer]');
                if (!currentDrawer || !nextDrawer) {
                    return false;
                }

                currentDrawer.replaceWith(nextDrawer);
                initAuditDetail(nextDrawer);
                bindDrawerActions();

                const selectedRequestId = nextDrawer.getAttribute('data-selected-request-id') || '';
                updateActiveRow(selectedRequestId);
                nextDrawer.classList.toggle('is-open', selectedRequestId !== '');
                return true;
            }

            async function loadDrawer(url, pushHistory) {
                try {
                    const response = await window.fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        credentials: 'same-origin'
                    });
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    const html = await response.text();
                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    if (!replaceDrawerFromDocument(doc)) {
                        throw new Error('Drawer não encontrado');
                    }

                    if (detailConfig.detailScrollKey !== '') {
                        window.localStorage.removeItem(detailConfig.detailScrollKey);
                    }

                    if (pushHistory) {
                        window.history.pushState({ url: url }, '', url);
                    }
                } catch (error) {
                    window.location.href = url;
                }
            }

            function closeDrawer(pushHistory) {
                const drawer = document.querySelector('[data-audit-detail-drawer]');
                if (!drawer) {
                    return;
                }

                drawer.classList.remove('is-open');
                drawer.setAttribute('data-selected-request-id', '');
                updateActiveRow('');

                const nextUrl = new URL(window.location.href);
                nextUrl.searchParams.delete('requisicao');
                if (pushHistory) {
                    window.history.pushState({ url: nextUrl.toString() }, '', nextUrl.toString());
                }
            }

            function bindDrawerActions() {
                document.querySelectorAll('[data-close-audit-drawer]').forEach(function (button) {
                    if (button.dataset.auditCloseInit === '1') {
                        return;
                    }
                    button.dataset.auditCloseInit = '1';
                    button.addEventListener('click', function () {
                        closeDrawer(true);
                    });
                });
            }

            initAuditDetail(document);
            bindDrawerActions();
            window.initCatalogSavedFilters({
                rootSelector: '[data-saved-filter-root]',
                storageKey: '{{ auditStoragePrefix }}_favoritos',
                emptyMessage: 'Nenhum filtro salvo ainda.'
            });

            document.addEventListener('click', function (event) {
                const link = event.target.closest('[data-audit-request-link]');
                if (!link) {
                    return;
                }

                const href = link.getAttribute('href') || '';
                if (href === '') {
                    return;
                }

                const targetUrl = new URL(href, window.location.origin);
                if (targetUrl.pathname !== window.location.pathname || !targetUrl.searchParams.get('requisicao')) {
                    return;
                }

                event.preventDefault();
                loadDrawer(targetUrl.toString(), true);
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeDrawer(true);
                }
            });

            window.addEventListener('popstate', function () {
                const currentUrl = new URL(window.location.href);
                if (currentUrl.pathname !== window.location.pathname) {
                    return;
                }
                if (currentUrl.searchParams.get('requisicao')) {
                    loadDrawer(currentUrl.toString(), false);
                    return;
                }
                closeDrawer(false);
            });
        });
    </script>
{% endblock %}
