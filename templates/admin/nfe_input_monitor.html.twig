{% extends 'admin/base.html.twig' %}

{% block title %}Monitor de entrada NFe{% endblock %}
{% block page_heading %}{% endblock %}
{% block heading_text %}{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/kendo/styles/default-main.css' }}">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-output-monitor.css' }}">
    <style>
        .portal-page-head {
            display: none;
        }
    </style>
{% endblock %}

{% block body %}
    <section
        id="nfe-output-monitor-app"
        class="card border-0 shadow-sm"
        data-base-path="{{ app.request.basePath }}"
        data-data-url="{{ dataUrl }}"
        data-filter-options-url="{{ filterOptionsUrl }}"
        data-filter-lookup-url="{{ filterLookupUrl }}"
        data-manifestation-url="{{ manifestationUrl }}"
        data-detail-url-template="{{ detailUrlTemplate }}"
        data-technical-detail-url-template="{{ technicalDetailUrlTemplate }}"
    >
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <h2 class="h4 mb-0">Monitor de entrada NFe</h2>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="open-nfe-output-filters" class="btn btn-outline-primary">Filtros</button>
                    <button type="button" id="clear-nfe-output-filters" class="btn btn-outline-secondary">Limpar filtros</button>
                </div>
            </div>

            <div id="nfe-output-monitor-grid"></div>
        </div>
    </section>

    <div id="nfe-output-filter-window" class="monitor-filter-window" style="display: none;">
        <form id="nfe-output-monitor-filters" class="monitor-filter-form">
            <div class="monitor-filter-grid">
                <div>
                    <label class="form-label" for="filter-date-from">Período de</label>
                    <input type="text" id="filter-date-from" name="date_from">
                </div>
                <div>
                    <label class="form-label" for="filter-date-to">Período até</label>
                    <input type="text" id="filter-date-to" name="date_to">
                </div>
                <div>
                    <label class="form-label" for="filter-numero-nota">Número da nota</label>
                    <input type="text" id="filter-numero-nota" name="numero_nota" placeholder="Ex: 123">
                </div>
                <div>
                    <label class="form-label" for="filter-cliente">Cliente</label>
                    <div class="monitor-lookup-field">
                        <input type="text" id="filter-cliente" name="cliente" placeholder="Nome">
                        <button type="button" class="btn btn-outline-secondary monitor-lookup-open" data-lookup-type="cliente" data-lookup-target="#filter-cliente">Buscar</button>
                    </div>
                </div>
                <div>
                    <label class="form-label" for="filter-assinante">Assinante</label>
                    <div class="monitor-lookup-field">
                        <input type="text" id="filter-assinante" name="assinante" placeholder="Nome">
                        <button type="button" class="btn btn-outline-secondary monitor-lookup-open" data-lookup-type="assinante" data-lookup-target="#filter-assinante">Buscar</button>
                    </div>
                </div>
                <div>
                    <label class="form-label" for="filter-emissor">Emissor</label>
                    <div class="monitor-lookup-field">
                        <input type="text" id="filter-emissor" name="emissor" placeholder="Nome">
                        <button type="button" class="btn btn-outline-secondary monitor-lookup-open" data-lookup-type="emissor" data-lookup-target="#filter-emissor">Buscar</button>
                    </div>
                </div>
                <div class="monitor-filter-span-2">
                    <label class="form-label" for="filter-chave">Chave de acesso</label>
                    <input type="text" id="filter-chave" name="chave" placeholder="44 dígitos">
                </div>
                <div class="monitor-filter-span-2">
                    <label class="form-label d-block">Status</label>
                    <div id="filter-status-group" class="monitor-status-group">
                        <label><input type="checkbox" name="status" value="3"> Concluído</label>
                        <label><input type="checkbox" name="status" value="4"> Falha</label>
                        <label><input type="checkbox" name="status" value="2"> Processando</label>
                        <label><input type="checkbox" name="status" value="1"> Pendente</label>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-4">
                <button class="btn btn-primary" type="submit">Aplicar filtros</button>
                <button class="btn btn-outline-secondary" type="reset">Limpar</button>
            </div>
        </form>
    </div>

    <div id="monitor-lookup-window" style="display: none;">
        <div class="monitor-lookup-layout">
            <div class="monitor-lookup-toolbar">
                <input type="text" id="monitor-lookup-query" placeholder="Digite para pesquisar">
                <button type="button" id="monitor-lookup-search">Pesquisar</button>
            </div>
            <div id="monitor-lookup-grid"></div>
            <div class="monitor-lookup-actions">
                <button type="button" id="monitor-lookup-select">Selecionar</button>
                <button type="button" id="monitor-lookup-cancel">Cancelar</button>
            </div>
        </div>
    </div>

    <div id="nfe-action-window" class="monitor-action-window" style="display: none;">
        <form id="nfe-action-form" class="monitor-action-form">
            <div class="monitor-action-summary" id="nfe-action-summary"></div>
            <label class="form-label" for="nfe-action-token">Token da API</label>
            <input type="password" id="nfe-action-token" name="token" autocomplete="off" required>
            <div id="nfe-manifestation-type-wrap" style="display: none;">
                <label class="form-label" for="nfe-manifestation-type">Manifestação</label>
                <select id="nfe-manifestation-type" name="tipo_manifestacao">
                    <option value="210210">Ciência da Operação</option>
                    <option value="210200">Confirmação da Operação</option>
                    <option value="210220">Desconhecimento da Operação</option>
                    <option value="210240">Operação não Realizada</option>
                </select>
            </div>
            <label class="form-label" for="nfe-action-justification" id="nfe-action-justification-label">Justificativa</label>
            <textarea id="nfe-action-justification" name="justificativa" rows="4" minlength="15"></textarea>
            <div class="form-text" id="nfe-action-help-text">Informe no mínimo 15 caracteres quando a ação exigir justificativa.</div>
            <div id="nfe-action-result" class="monitor-action-result" aria-live="polite"></div>
            <div class="monitor-action-buttons">
                <button type="submit" id="nfe-action-confirm">Confirmar</button>
                <button type="button" id="nfe-action-close">Fechar</button>
            </div>
        </form>
    </div>
{% endblock %}

{% block page_scripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/kendo.all.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/cultures/kendo.culture.pt-BR.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/messages/kendo.messages.pt-BR.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/kendo-license.js' }}"></script>
    <script>
        kendo.culture("pt-BR");
    </script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-output-monitor.js' }}"></script>
{% endblock %}
