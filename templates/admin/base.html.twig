<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Portal Administrativo{% endblock %}</title>
    <link rel="icon" href="https://raw.githubusercontent.com/Projeto-ACBr-Oficial/Docker/main/PHP/img/favico-acbr.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc7/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/catalog.css' }}">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/adminlte-portal.css' }}">
    {% block page_styles %}{% endblock %}
</head>
{% set currentRoute = app.request.attributes.get('_route') %}
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary app-loaded">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Alternar menu lateral">
                        <i class="bi bi-list"></i>
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ app.request.basePath ~ '/index.php/docs' }}" target="_blank" rel="noreferrer">
                        <i class="bi bi-box-arrow-up-right"></i>
                        Documentação da API
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a href="{{ app.request.basePath ~ '/index.php/' }}" class="brand-link">
                <span class="brand-text fw-semibold">ACBr Portal</span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                    <li class="nav-header">Visão Geral</li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/' }}" class="nav-link{% if currentRoute == 'app_home' %} active{% endif %}">
                            <i class="nav-icon bi bi-grid-1x2"></i>
                            <p>Hub administrativo</p>
                        </a>
                    </li>

                    <li class="nav-header">Navegação</li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/apis' }}" class="nav-link{% if currentRoute == 'app_apis' %} active{% endif %}">
                            <i class="nav-icon bi bi-journal-code"></i>
                            <p>APIs e documentação</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/demos' }}" class="nav-link{% if currentRoute == 'app_demos' %} active{% endif %}">
                            <i class="nav-icon bi bi-window-sidebar"></i>
                            <p>Demos legados</p>
                        </a>
                    </li>

                    <li class="nav-header">Operação</li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/catalogo-programas' }}" class="nav-link{% if currentRoute == 'app_program_catalog' %} active{% endif %}">
                            <i class="nav-icon bi bi-diagram-3"></i>
                            <p>Catálogo de programas</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/catalogo-testes' }}" class="nav-link{% if currentRoute == 'app_test_catalog' %} active{% endif %}">
                            <i class="nav-icon bi bi-bezier2"></i>
                            <p>Catálogo de testes</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/configuracao-execucao' }}" class="nav-link{% if currentRoute == 'app_execution_config' %} active{% endif %}">
                            <i class="nav-icon bi bi-sliders"></i>
                            <p>Configuração de execução</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/capacidade-workers' }}" class="nav-link{% if currentRoute == 'app_worker_capacity' %} active{% endif %}">
                            <i class="nav-icon bi bi-cpu"></i>
                            <p>Capacidade de workers</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/monitor-workers' }}" class="nav-link{% if currentRoute == 'app_worker_monitor' %} active{% endif %}">
                            <i class="nav-icon bi bi-activity"></i>
                            <p>Monitor de workers</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/assinantes' }}" class="nav-link{% if currentRoute == 'app_subscribers' %} active{% endif %}">
                            <i class="nav-icon bi bi-people"></i>
                            <p>Assinantes</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/webhooks' }}" class="nav-link{% if currentRoute == 'app_webhooks' %} active{% endif %}">
                            <i class="nav-icon bi bi-broadcast"></i>
                            <p>Webhooks</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/consulta-requisicoes' }}" class="nav-link{% if currentRoute == 'app_api_request_lookup' %} active{% endif %}">
                            <i class="nav-icon bi bi-search"></i>
                            <p>Consulta de requisições</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes/visao-analitica' }}" class="nav-link{% if currentRoute == 'app_api_audit_overview' %} active{% endif %}">
                            <i class="nav-icon bi bi-graph-up-arrow"></i>
                            <p>Auditoria analítica</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <main class="app-main">
        <div class="app-content portal-content-wrap">
            <div class="container-fluid">
                <section class="portal-page-head">
                    <div>
                        <h1>{% block heading %}{% block page_heading %}Portal Administrativo{% endblock %}{% endblock %}</h1>
                        <p>{% block heading_text %}Acesso centralizado às páginas Symfony/Twig do ambiente.{% endblock %}</p>
                    </div>
                </section>

                {% for message in app.flashes('success') %}
                    <div class="flash flash-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash-error">{{ message }}</div>
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <div class="float-end d-none d-sm-inline">AdminLTE 4 + Symfony</div>
        <strong>Portal administrativo ACBr</strong>
    </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc7/dist/js/adminlte.min.js"></script>
{% block page_scripts %}{% endblock %}
</body>
</html>
