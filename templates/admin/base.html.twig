<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %}</title>
    <link rel="icon" href="https://raw.githubusercontent.com/Projeto-ACBr-Oficial/Docker/main/PHP/img/favico-acbr.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc7/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/catalog.css' }}">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/adminlte-bridge.css' }}">
    {% block page_styles %}{% endblock %}
</head>
{% set currentRoute = app.request.attributes.get('_route') %}
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Alternar menu lateral">
                        <i class="bi bi-list"></i>
                    </a>
                </li>
            </ul>
            <div class="admin-header-copy">
                <strong>{% block header_title %}Hub Administrativo{% endblock %}</strong>
                <span>{% block header_subtitle %}Operação, documentação e monitoramento do ambiente ACBr.{% endblock %}</span>
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ app.request.basePath ~ '/index.php/docs' }}" target="_blank" rel="noreferrer">
                        <i class="bi bi-box-arrow-up-right"></i>
                        API Platform
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a href="{{ app.request.basePath ~ '/index.php/' }}" class="brand-link">
                <span class="brand-text fw-semibold">ACBr Admin</span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                    <li class="nav-header">Painel</li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/' }}" class="nav-link{% if currentRoute == 'app_home' %} active{% endif %}">
                            <i class="nav-icon bi bi-speedometer2"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/operacao' }}" class="nav-link{% if currentRoute == 'app_operations' %} active{% endif %}">
                            <i class="nav-icon bi bi-diagram-3"></i>
                            <p>Operação por módulo</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/monitoramento' }}" class="nav-link{% if currentRoute == 'app_monitoring' %} active{% endif %}">
                            <i class="nav-icon bi bi-activity"></i>
                            <p>Monitoramento</p>
                        </a>
                    </li>

                    <li class="nav-header">Acesso</li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/apis' }}" class="nav-link{% if currentRoute == 'app_apis' %} active{% endif %}">
                            <i class="nav-icon bi bi-journal-code"></i>
                            <p>Documentação</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/demos' }}" class="nav-link{% if currentRoute == 'app_demos' %} active{% endif %}">
                            <i class="nav-icon bi bi-window-stack"></i>
                            <p>Demos legados</p>
                        </a>
                    </li>

                    <li class="nav-header">Catálogos</li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/catalogo-programas' }}" class="nav-link{% if currentRoute == 'app_program_catalog' %} active{% endif %}">
                            <i class="nav-icon bi bi-collection"></i>
                            <p>Programas</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/catalogo-testes' }}" class="nav-link{% if currentRoute == 'app_test_catalog' %} active{% endif %}">
                            <i class="nav-icon bi bi-bezier2"></i>
                            <p>Testes</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes' }}" class="nav-link{% if currentRoute == 'app_api_audit_dashboard' %} active{% endif %}">
                            <i class="nav-icon bi bi-shield-check"></i>
                            <p>Auditoria</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <main class="app-main">
        <div class="app-content">
            <div class="container-fluid admin-page">
                {% for message in app.flashes('success') %}
                    <div class="flash flash-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash-error">{{ message }}</div>
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc7/dist/js/adminlte.min.js"></script>
{% block page_scripts %}{% endblock %}
</body>
</html>
