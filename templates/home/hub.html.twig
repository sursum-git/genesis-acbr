{% extends 'admin/base.html.twig' %}

{% block title %}Hub Administrativo{% endblock %}
{% block page_title %}Hub Administrativo{% endblock %}
{% block page_subtitle %}Acesso central às áreas Symfony/Twig do portal administrativo.{% endblock %}
{% block page_heading %}Novo padrão visual do portal{% endblock %}
{% block heading_text %}A navegação principal foi reorganizada em blocos claros, com menu lateral fixo e superfícies mais adequadas para um sistema administrativo em azul e branco.{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Hub</li>
{% endblock %}

{% block body %}
    <section class="portal-dashboard-grid">
        <article class="portal-panel">
            <div class="portal-kicker">Entrada principal</div>
            <h2>Comece pela área que resolve sua tarefa</h2>
            <p>O hub agora prioriza fluxos de navegação e acompanhamento operacional. As páginas de trabalho detalhado continuam nos catálogos e na auditoria.</p>
            <div class="portal-card-list">
                <a class="portal-action-card" href="{{ app.request.basePath ~ '/index.php/apis' }}">
                    <strong>Documentação das APIs</strong>
                    <span>Escolha rapidamente entre documentação geral, CEP, NFe e NFSe.</span>
                    <div class="portal-chip-row">
                        <span class="portal-chip">Swagger</span>
                        <span class="portal-chip">Filtros por módulo</span>
                    </div>
                </a>
                <a class="portal-action-card" href="{{ app.request.basePath ~ '/index.php/demos' }}">
                    <strong>Demos legados</strong>
                    <span>Agrupamento dos acessos aos demos antigos, mantidos separados da camada moderna.</span>
                    <div class="portal-chip-row">
                        <span class="portal-chip">Boleto</span>
                        <span class="portal-chip">CEP</span>
                        <span class="portal-chip">NFe/NFSe</span>
                    </div>
                </a>
                <a class="portal-action-card" href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes' }}">
                    <strong>Auditoria operacional</strong>
                    <span>Revisão de requisições, filtros avançados, tentativas e detalhes de processamento.</span>
                    <div class="portal-chip-row">
                        <span class="portal-chip">Filtros</span>
                        <span class="portal-chip">Detalhe completo</span>
                    </div>
                </a>
            </div>
        </article>

        <article class="portal-panel">
            <div class="portal-kicker">Áreas técnicas</div>
            <h2>Acessos diretos</h2>
            <p>Entradas permanentes para as telas mais usadas do portal.</p>
            <div class="portal-link-list">
                <a class="portal-link-card" href="{{ catalogUrl }}">
                    <strong>Catálogo de programas</strong>
                    <span>Inventário técnico do repositório com histórico local em SQLite.</span>
                </a>
                <a class="portal-link-card" href="{{ testCatalogUrl }}">
                    <strong>Catálogo de testes</strong>
                    <span>Cenários gravados, reruns e acompanhamento de lotes executados.</span>
                </a>
                <a class="portal-link-card" href="{{ app.request.basePath ~ '/index.php/docs' }}">
                    <strong>Swagger geral</strong>
                    <span>Visualização direta da documentação completa do API Platform.</span>
                </a>
            </div>
        </article>
    </section>

    <section class="portal-nav-grid">
        <article class="portal-panel">
            <div class="portal-kicker">Operação por módulo</div>
            <h3>CEP, NFe e NFSe</h3>
            <p>Atalhos organizados por módulo para evitar busca manual por URL.</p>
            <div class="portal-card-list">
                {% for stack in moduleStacks %}
                    <div class="portal-action-card">
                        <strong>{{ stack.label }}</strong>
                        <span>{{ stack.description }}</span>
                        <div class="portal-actions-inline">
                            {% for link in stack.links %}
                                <a class="button button-secondary" href="{{ link.url }}">{{ link.label }}</a>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </article>

        <article class="portal-panel">
            <div class="portal-kicker">Fluxos modernos</div>
            <h3>Documentação filtrada</h3>
            <p>Entradas dedicadas aos recortes do API Platform expostos pelo portal.</p>
            <div class="portal-link-list">
                {% for item in apiOptions %}
                    <a class="portal-link-card" href="{{ item.url }}">
                        <strong>{{ item.label }}</strong>
                        <span>{{ item.description }}</span>
                    </a>
                {% endfor %}
            </div>
        </article>

        <article class="portal-panel">
            <div class="portal-kicker">Legado acessível</div>
            <h3>Demos por área</h3>
            <p>A navegação dos demos continua disponível, mas isolada das telas de operação moderna.</p>
            <div class="portal-link-list">
                {% for item in demoOptions %}
                    <a class="portal-link-card" href="{{ item.url }}">
                        <strong>{{ item.label }}</strong>
                        <span>{{ item.description }}</span>
                    </a>
                {% endfor %}
            </div>
        </article>
    </section>

    <section class="portal-overview-grid">
        <article class="portal-panel">
            <div class="portal-kicker">Acompanhamento</div>
            <h2>Falhas recentes</h2>
            <p>Últimos registros com problema para entrar direto no detalhe da auditoria.</p>
            <div class="portal-activity-list">
                {% for item in recentFailures %}
                    <a class="portal-activity-card" href="{{ app.request.basePath ~ '/index.php/auditoria-requisicoes?requisicao=' ~ item.u_c_request_id }}">
                        <strong>{{ item.c_metodo }} {{ item.c_caminho }}</strong>
                        <div class="portal-chip-row">
                            <span class="portal-chip chip-danger">{{ item.si_status_http ?: 'falha' }}</span>
                            <span class="portal-chip">{{ item.c_assinante_identificador ?: 'sem assinante' }}</span>
                            <span class="portal-chip">{{ item.c_cod_programa ?: 'n/d' }}</span>
                        </div>
                        <p>{{ item.t_resumo ?: 'Sem resumo adicional.' }}</p>
                    </a>
                {% else %}
                    <div class="portal-empty">Nenhuma falha recente encontrada.</div>
                {% endfor %}
            </div>
        </article>

        <article class="portal-panel">
            <div class="portal-kicker">Acompanhamento</div>
            <h2>Últimos testes observados</h2>
            <p>Cenários gravados mais recentemente para voltar direto ao catálogo.</p>
            <div class="portal-activity-list">
                {% for test in recentTests %}
                    <a class="portal-activity-card" href="{{ app.request.basePath ~ '/index.php/catalogo-testes?teste=' ~ test.code }}">
                        <strong>{{ test.name }}</strong>
                        <div class="portal-chip-row">
                            <span class="portal-chip">{{ test.method }}</span>
                            <span class="portal-chip">{{ test.group_name }}</span>
                            {% if test.last_run %}
                                <span class="portal-chip{% if test.last_run.success %} chip-success{% else %} chip-danger{% endif %}">
                                    {{ test.last_run.success ? 'ok' : 'erro' }}
                                </span>
                            {% endif %}
                        </div>
                        <p>{{ test.path }}</p>
                    </a>
                {% else %}
                    <div class="portal-empty">Nenhum teste recente encontrado.</div>
                {% endfor %}
            </div>
        </article>
    </section>
{% endblock %}
