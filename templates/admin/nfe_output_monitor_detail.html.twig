{% extends 'admin/base.html.twig' %}

{% block title %}Saída da NFe {{ detail.numero_nota ?: detail.request_id }}{% endblock %}
{% block page_heading %}Saída da NFe{% endblock %}
{% block heading_text %}{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/kendo/styles/default-main.css' }}">
    <link rel="stylesheet" href="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-output-monitor.css' }}">
{% endblock %}

{% block body %}
    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-start gap-3">
                <div>
                    <div class="small text-muted text-uppercase">Nota fiscal eletrônica</div>
                    <h2 class="h3 mb-1">Nota {{ detail.numero_nota ?: 'sem número estruturado' }}</h2>
                    <p class="text-muted mb-0">{{ detail.cliente ?: 'Destinatário não identificado' }}</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="{{ backUrl }}">Voltar</a>
                    <span class="badge text-bg-primary">{{ detail.status_envio }}</span>
                    <span class="badge {{ detail.situacao_nfe == 'Cancelada' or detail.situacao_nfe == 'Inutilizada' ? 'text-bg-danger' : 'text-bg-success' }}">{{ detail.situacao_nfe }}</span>
                    {% if detail.xml_url %}
                        <a class="btn btn-primary btn-sm" href="{{ app.request.basePath ~ '/index.php' ~ detail.xml_url }}">XML</a>
                    {% endif %}
                    <a class="btn btn-outline-secondary btn-sm" href="{{ technicalUrl }}">Visão técnica</a>
                </div>
            </div>
        </div>
    </section>

    <div id="nfe-output-detail-tabs" class="mb-4">
        <ul>
            <li class="k-active">Dados da nota</li>
            <li>Itens</li>
            <li>Eventos</li>
        </ul>
        <div>
    <section class="card border-0 shadow-sm mb-4">
        <div class="card-header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title mb-0">Situação da NFe</h3>
                <span class="badge {{ detail.situacao_nfe == 'Cancelada' or detail.situacao_nfe == 'Inutilizada' ? 'text-bg-danger' : 'text-bg-success' }}">{{ detail.situacao_nfe }}</span>
            </div>
        </div>
        <div class="card-body">
            <dl class="row monitor-dl">
                <dt class="col-sm-3">Status do envio</dt><dd class="col-sm-9">{{ detail.status_envio }}</dd>
                <dt class="col-sm-3">Situação fiscal</dt><dd class="col-sm-9">{{ detail.situacao_nfe }}</dd>
                {% if detail.cancelamento.cancelada %}
                    <dt class="col-sm-3">Cancelamento</dt>
                    <dd class="col-sm-9">
                        {% if detail.cancelamento.c_stat %}{{ detail.cancelamento.c_stat }} - {% endif %}{{ detail.cancelamento.motivo ?: 'Cancelada' }}
                        {% if detail.cancelamento.protocolo %}<br>Protocolo: {{ detail.cancelamento.protocolo }}{% endif %}
                    </dd>
                {% endif %}
            </dl>
        </div>
    </section>

    {% if detail.cancelamento.cancelada %}
        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header"><h3 class="card-title">Cancelamento</h3></div>
            <div class="card-body">
                <dl class="row mb-0 monitor-dl">
                    <dt class="col-sm-3">Situação</dt><dd class="col-sm-9">Cancelada</dd>
                    <dt class="col-sm-3">Protocolo</dt><dd class="col-sm-9">{{ detail.cancelamento.protocolo ?: '-' }}</dd>
                    <dt class="col-sm-3">Retorno SEFAZ</dt><dd class="col-sm-9">{% if detail.cancelamento.c_stat %}{{ detail.cancelamento.c_stat }} - {% endif %}{{ detail.cancelamento.motivo ?: '-' }}</dd>
                    <dt class="col-sm-3">Data do evento</dt><dd class="col-sm-9">{% if detail.cancelamento.data %}{{ detail.cancelamento.data|date('d/m/Y H:i') }}{% else %}-{% endif %}</dd>
                    <dt class="col-sm-3">Request ID</dt><dd class="col-sm-9"><code>{{ detail.cancelamento.request_id ?: '-' }}</code></dd>
                </dl>
            </div>
        </section>
    {% endif %}

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-6">
            <section class="card h-100">
                <div class="card-header"><h3 class="card-title">Emitente</h3></div>
                <div class="card-body">
                    <dl class="row mb-0 monitor-dl">
                        <dt class="col-sm-4">Razão social</dt><dd class="col-sm-8">{{ detail.emitente_nome ?: '-' }}</dd>
                        <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">{{ detail.emitente_documento ?: '-' }}</dd>
                        <dt class="col-sm-4">Emissão</dt><dd class="col-sm-8">{% if detail.data_emissao %}{{ detail.data_emissao|date('d/m/Y H:i') }}{% else %}-{% endif %}</dd>
                    </dl>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-6">
            <section class="card h-100">
                <div class="card-header"><h3 class="card-title">Destinatário</h3></div>
                <div class="card-body">
                    <dl class="row mb-0 monitor-dl">
                        <dt class="col-sm-4">Razão social</dt><dd class="col-sm-8">{{ detail.cliente ?: '-' }}</dd>
                        <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">{{ detail.cliente_documento ?: '-' }}</dd>
                        <dt class="col-sm-4">Chave</dt><dd class="col-sm-8 monitor-break">{{ detail.chave_nfe ?: '-' }}</dd>
                    </dl>
                </div>
            </section>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-4">
            <section class="card h-100">
                <div class="card-header"><h3 class="card-title">Resumo da nota</h3></div>
                <div class="card-body">
                    <dl class="row mb-0 monitor-dl">
                        <dt class="col-sm-5">Número</dt><dd class="col-sm-7">{{ detail.numero_nota ?: '-' }}</dd>
                        <dt class="col-sm-5">Envio</dt><dd class="col-sm-7">{% if detail.data_envio %}{{ detail.data_envio|date('d/m/Y H:i') }}{% else %}-{% endif %}</dd>
                        <dt class="col-sm-5">Valor total</dt><dd class="col-sm-7">{% if detail.valor_total %}{{ detail.valor_total|number_format(2, ',', '.') }}{% else %}-{% endif %}</dd>
                        <dt class="col-sm-5">Assinante</dt><dd class="col-sm-7">{{ detail.assinante_nome ?: detail.assinante_identificador ?: '-' }}</dd>
                    </dl>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-8">
            <section class="card h-100">
                <div class="card-header"><h3 class="card-title">Totais de impostos</h3></div>
                <div class="card-body">
                    <div class="monitor-tax-grid">
                        {% for nome, imposto in detail.impostos %}
                            {% if imposto %}
                                <div class="monitor-tax-card">
                                    <div class="monitor-tax-title">{{ nome }}</div>
                                    <div>Valor: {% if imposto.valor %}{{ imposto.valor|number_format(2, ',', '.') }}{% else %}-{% endif %}</div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </section>
        </div>
    </div>
        </div>
        <div>

    <section class="card border-0 shadow-sm">
        <div class="card-header"><h3 class="card-title">Itens da nota</h3></div>
        <div class="card-body">
            <div id="nfe-output-items-grid" data-items='{{ detail.itens|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}'></div>
        </div>
    </section>
        </div>
        <div>
            <section class="card border-0 shadow-sm">
                <div class="card-header"><h3 class="card-title">Eventos da nota</h3></div>
                <div class="card-body">
                    <p class="text-muted mb-3">Histórico fiscal da nota em linguagem simples para acompanhamento pelo usuário.</p>
                    <div
                        id="nfe-detail-fiscal-events-grid"
                        data-events='{{ detail.eventos_nfe|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}'
                    ></div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block page_scripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/kendo.all.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/cultures/kendo.culture.pt-BR.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/js/messages/kendo.messages.pt-BR.min.js' }}"></script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/kendo/kendo-license.js' }}"></script>
    <script>
        kendo.culture("pt-BR");
    </script>
    <script src="{{ app.request.basePath ~ '/catalog-assets/monitor/nfe-output-monitor-detail.js' }}"></script>
{% endblock %}
